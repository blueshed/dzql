@startuml
title Dee enters a name, then general, and says hello
actor "Dee" as dee
participant "Chat" as app
actor "Ada, Bob (in general)" as general
actor "Cy (in the kitchen)" as kitchen

dee -> app : enterName("")
app --> dee : a name is needed
dee -> app : enterName("Dee")
app --> dee : ok
dee -> app : enterRoomName("")
app --> dee : a room's name is needed
dee -> app : enterRoomName("general")
app --> dee : the room, its members, its messages
app -> general : Dee arrives
dee -> app : say("hello")
app --> dee : the message
app -> general : Dee: hello
note over kitchen : nothing: not in general
@enduml
