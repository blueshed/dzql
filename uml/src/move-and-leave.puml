@startuml
title Cy enters general's name from the kitchen, then logs out
actor "Cy" as cy
participant "Chat" as app
actor "the kitchen" as kitchen
actor "general" as general

cy -> app : enterRoomName("general")
app --> cy : the room, its members, its messages
app -> kitchen : Cy has gone
app -> general : Cy arrives
cy -> app : logout()
app --> cy : ok
app -> general : Cy has gone
@enduml
