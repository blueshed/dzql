@startuml
title Classes: the documents' shapes
hide empty methods

class "room:<name>" as RoomDoc <<document>> {
  name
  members
  messages
}

class "session" as SessionDoc <<document>> {
  name
  room
}

class "lobby" as LobbyDoc <<document>> {
  rooms
}

class Message {
  author
  text
  at
}

RoomDoc *-- "0..*" Message : messages
SessionDoc ..> RoomDoc : room names one >
LobbyDoc ..> RoomDoc : lists the ones with people in >
@enduml
