@startuml
title Classes: chat
hide empty methods

class Session {
  id
  name
  room
  state : SessionState
}

class Room {
  name
}

class Message {
  id
  room
  author
  text
  at
}

Session "0..*" -- "0..1" Room : is in >
Room "1" -- "0..*" Message : holds >
Session "1" -- "0..*" Message : wrote >
@enduml
