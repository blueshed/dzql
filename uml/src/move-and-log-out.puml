@startuml
title Cy enters general's name from the kitchen, then logs out
actor "Cy" as cy
participant "Chat" as app
actor "Eve (has room:kitchen open)" as kitchen
actor "Ada, Bob (have room:general open)" as general

cy -> app : replace session /room "general"
app --> cy : patch session replace /room "general"
app --> cy : open room:general
app -> kitchen : patch room:kitchen remove /members/1
app -> general : patch room:general add /members/- "Cy"
cy -> app : remove session
app -> general : patch room:general remove /members/2
@enduml
