{
  "name": "eta",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/start.ts",
    "dev:wedding": "ETA_EXAMPLE=wedding PORT=3001 bun --watch src/start.ts",
    "dev:ticker": "ETA_EXAMPLE=ticker PORT=3002 bun --watch src/start.ts",
    "dev:bento": "PORT=3003 bun --watch examples/bento/server.ts",
    "start": "nohup bun src/start.ts > ${LOG_FILE:-server.log} 2>&1 & disown",
    "stop": "kill $(cat ${PID_FILE:-server.pid})",
    "cli": "bun src/cli.ts",
    "test": "DB_PATH=:memory: TICK_MS=0 bun test --coverage",
    "stories": "DB_PATH=:memory: TICK_MS=0 bun src/stories-run.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "lucide": "^1.46.0"
  }
}
