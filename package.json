{
  "name": "eta",
  "version": "0.52.0",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "private": true,
  "type": "module",
  "bun-create": {
    "postinstall": "create/setup.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test.entry.*",
    "!src/server.test.fixture.html",
    ".claude/skills",
    "README.md",
    "CHANGELOG.md",
    "docs/stories.md",
    "docs/first-app.md"
  ],
  "scripts": {
    "dev": "bun --watch src/start.ts",
    "dev:wedding": "ETA_EXAMPLE=wedding PORT=3001 bun --watch src/start.ts",
    "dev:ticker": "ETA_EXAMPLE=ticker PORT=3002 bun --watch src/start.ts",
    "dev:leave": "ETA_EXAMPLE=leave PORT=3004 bun --watch src/start.ts",
    "dev:modeling": "ETA_EXAMPLE=modeling PORT=3005 bun --watch src/start.ts",
    "start": "NODE_ENV=production nohup bun src/start.ts > ${LOG_FILE:-server.log} 2>&1 & disown",
    "stop": "kill $(lsof -ti tcp:${PORT:-3000} -sTCP:LISTEN)",
    "cli": "bun src/cli.ts",
    "test": "bun test --parallel",
    "stories": "bun --env-file=.env.test src/stories-run.ts",
    "stories:all": "STORY_BY_HAND=1 ETA_EXAMPLE=chat bun run stories && STORY_BY_HAND=1 ETA_EXAMPLE=ticker bun run stories && STORY_BY_HAND=1 ETA_EXAMPLE=wedding bun run stories && STORY_BY_HAND=1 ETA_EXAMPLE=leave bun run stories && STORY_BY_HAND=1 ETA_EXAMPLE=modeling bun run stories",
    "costs": "bun --env-file=.env.test src/costs.ts",
    "model:check": "LOG_LEVEL=warn bun --env-file=.env.test examples/modeling/loader/check.ts",
    "model:load": "LOG_LEVEL=warn bun --env-file=.env.test examples/modeling/loader/load.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "dependencies": {
    "@blueshed/delta": "^0.13.1",
    "@blueshed/railroad": "^0.16.2",
    "lucide": "^1.46.0"
  }
}
