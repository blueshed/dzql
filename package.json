{
  "name": "dzql-monorepo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "DZQL - PostgreSQL-powered framework with zero boilerplate",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "client": "cd packages/client && bun run dev",
    "server": "cd packages/venues && bun run dev",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"bun run client\" \"bun run server\"",
    "venues": "cd packages/venues && bun dev",
    "rights": "cd packages/rights && bun dev",
    "down": "cd tests && docker compose down && cd ../packages/venues && bun db:down && cd ../rights && bun db:down && cd ../blog && bun db:down",
    "test": "docker compose -f tests/compose.yml up -d && sleep 5 && bun test tests/core/ tests/integration/ tests/migrations/",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.turbo .turbo"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "keywords": [
    "postgresql",
    "websocket",
    "real-time",
    "crud",
    "api",
    "framework",
    "zero-boilerplate"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
