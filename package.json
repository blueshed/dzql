{
  "name": "bluetools",
  "private": true,
  "type": "module",
  "description": "The blueshed lineage in one repo: railroad, delta, dzql and their starters (each with its template, a workspace too), as Bun workspaces",
  "workspaces": [
    "packages/*",
    "packages/*/template"
  ],
  "scripts": {
    "test": "bun scripts/affected.ts --all",
    "affected": "bun scripts/affected.ts",
    "test:railroad": "bun run --cwd packages/railroad test:fast",
    "test:railroad:slow": "bun run --cwd packages/railroad test:slow",
    "test:delta": "bun run --cwd packages/delta test:fast",
    "test:delta:slow": "bun run --cwd packages/delta test:slow",
    "test:dzql": "bun run --cwd packages/dzql test:fast",
    "test:dzql:slow": "bun run --cwd packages/dzql test:slow",
    "test:create-blueshed": "bun run --cwd packages/create-blueshed test:fast",
    "test:create-blueshed:slow": "bun run --cwd packages/create-blueshed test:slow",
    "test:create-dzql": "bun run --cwd packages/create-dzql test:fast"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.4"
}
