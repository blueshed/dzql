{
  "name": "dzql-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DZQL - PostgreSQL-powered framework with zero boilerplate",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "client": "cd packages/client && bun run dev",
    "server": "cd packages/venues && bun run dev",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"bun run client\" \"bun run server\"",
    "db": "cd packages/venues/database && docker compose -p venues down -v && docker compose -p venues up -d",
    "logs": "bun run --cwd packages/venues db:logs",
    "venues": "cd packages/venues && bun dev",
    "venues:test": "cd packages/venues && bun test",
    "venues:db": "cd packages/venues/database && docker compose -p venues down -v && docker compose -p venues up -d",
    "venues:logs": "bun run --cwd packages/venues db:logs",
    "rights": "cd packages/rights && bun dev",
    "rights:test": "cd packages/rights && bun test",
    "rights:db": "cd packages/rights && bun db",
    "rights:logs": "bun run --cwd packages/rights db:logs"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "keywords": [
    "postgresql",
    "websocket",
    "real-time",
    "crud",
    "api",
    "framework",
    "zero-boilerplate"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1",
    "postgres": "^3.4.7"
  }
}
