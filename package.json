{
  "name": "zeroql-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZeroQL - PostgreSQL-powered framework with zero boilerplate",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "client": "cd packages/client && bun run dev",
    "server": "cd packages/rights && bun run dev",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"bun run client\" \"bun run server\"",
    "db": "cd packages/rights/database && docker compose down -v && docker compose up -d",
    "db:logs": "bun run --cwd packages/rights db:logs"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/zeroql"
  },
  "keywords": [
    "postgresql",
    "websocket",
    "real-time",
    "crud",
    "api",
    "framework",
    "zero-boilerplate"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
