{
  "name": "bluetools",
  "private": true,
  "type": "module",
  "description": "The blueshed lineage in one repo: railroad, delta, dzql and their starters, as Bun workspaces",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "cd packages/dzql && bun run test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "cache:clear": "bun pm cache rm"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "keywords": [
    "delta",
    "postgres",
    "postgresql",
    "compiler",
    "bun",
    "typescript"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "overrides": {
    "@types/node": "^25.5.0"
  }
}
