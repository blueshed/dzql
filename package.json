{
  "name": "dzql-monorepo",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "DZQL - Database-first, real-time framework for PostgreSQL",
  "workspaces": [
    "packages/dzql",
    "packages/tzql",
    "packages/create-dzql"
  ],
  "scripts": {
    "test": "cd packages/tzql && bun run test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "cache:clear": "bun pm cache rm"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "keywords": [
    "postgresql",
    "websocket",
    "real-time",
    "typescript",
    "compiler",
    "framework"
  ],
  "author": "Peter Bunyan",
  "license": "MIT"
}
