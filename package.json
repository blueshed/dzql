{
  "name": "dzql-monorepo",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "dzql, delta's compiled Postgres step, and create-dzql",
  "workspaces": [
    "packages/dzql",
    "packages/create-dzql"
  ],
  "scripts": {
    "test": "cd packages/dzql && bun run test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "cache:clear": "bun pm cache rm"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "keywords": [
    "delta",
    "postgres",
    "postgresql",
    "compiler",
    "bun",
    "typescript"
  ],
  "author": "Peter Bunyan",
  "license": "MIT"
}
