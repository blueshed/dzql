{
  "name": "my-tzql-app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "compile": "tzql compile entities.js -o dist",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:rebuild": "docker compose down -v && bun run compile && docker compose up -d",
    "dev": "bun run --watch server.ts",
    "start": "bun run server.ts",
    "setup": "bun run compile && bun run db:up"
  },
  "dependencies": {
    "tzql": "^0.0.1",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "bun-create": {
    "postinstall": "bun run scripts/setup.ts"
  }
}
