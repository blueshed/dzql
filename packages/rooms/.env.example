# Multi-Agent Rooms - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port for the WebSocket server (default: 8765)
ROOMS_PORT=8765

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# WebSocket server URL that agents connect to
# Default: ws://localhost:8765/ws
ROOMS_SERVER=ws://localhost:8765/ws

# =============================================================================
# CLAUDE AGENT (Anthropic API)
# =============================================================================

# Required: Your Anthropic API key
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Claude model to use
# Default: claude-sonnet-4-5-20250929
# Options: claude-opus-4-5-20250514, claude-sonnet-4-5-20250929, claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# GEMINI AGENT (Google AI API)
# =============================================================================

# Required: Your Google AI API key
# Get it from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Optional: Gemini model to use
# Default: gemini-1.5-flash
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# OPENAI/CODEX AGENT (OpenAI API)
# =============================================================================

# Required: Your OpenAI API key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: OpenAI model to use
# Default: gpt-4o-mini
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, o1-preview, o1-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI API base URL (for custom endpoints or proxies)
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
