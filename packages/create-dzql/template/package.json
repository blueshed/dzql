{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "PGLITE_DIR=data/pg bun --hot src/routes.ts --model",
    "start": "NODE_ENV=production PGLITE_DIR=data/pg bun src/routes.ts",
    "stop": "delta stop",
    "stories": "ETA_EXAMPLE=./src bun node_modules/dzql/src/modelling/stories-run.ts",
    "cli": "ETA_EXAMPLE=./src bun node_modules/dzql/src/rendering/cli.ts",
    "model": "dzql model",
    "model:load": "LOG_LEVEL=warn bun node_modules/dzql/src/modelling/page/loader/load.ts ./src",
    "model:check": "LOG_LEVEL=warn bun node_modules/dzql/src/modelling/page/loader/check.ts ./src",
    "typecheck": "bun check",
    "test": "bun test",
    "prepare": "delta install-skills"
  },
  "dependencies": {
    "@blueshed/delta": "^1.2.0",
    "@electric-sql/pglite": "^0.5.4",
    "dzql": "^0.14.0",
    "lucide": "^1.46.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.20.0"
  },
  "claudeSkills": [
    "dzql"
  ]
}
