{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --hot node_modules/dzql/src/cli/index.ts serve ./src",
    "start": "NODE_ENV=production bun node_modules/dzql/src/cli/index.ts serve ./src",
    "stop": "delta stop",
    "stories": "ETA_EXAMPLE=./src bun node_modules/dzql/src/modelling/stories-run.ts",
    "cli": "ETA_EXAMPLE=./src bun node_modules/dzql/src/rendering/cli.ts",
    "model": "bun node_modules/dzql/src/cli/index.ts model",
    "cli:model": "bun node_modules/dzql/src/cli/index.ts model",
    "model:load": "LOG_LEVEL=warn ETA_URL=ws://localhost:${MODEL_PORT:-3001}/model bun node_modules/dzql/examples/modeling/loader/load.ts ./src",
    "model:check": "LOG_LEVEL=warn ETA_URL=ws://localhost:${MODEL_PORT:-3001}/model bun node_modules/dzql/examples/modeling/loader/check.ts ./src",
    "typecheck": "bun check",
    "test": "bun test",
    "prepare": "delta install-skills"
  },
  "dependencies": {
    "@blueshed/delta": "^1.2.0",
    "dzql": "^0.13.0",
    "lucide": "^1.46.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "claudeSkills": [
    "dzql"
  ]
}
