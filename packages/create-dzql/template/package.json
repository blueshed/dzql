{
  "name": "dzql-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --hot src/routes.ts --model",
    "start": "NODE_ENV=production bun src/routes.ts",
    "stop": "delta stop",
    "stories": "dzql stories ./src",
    "cli": "dzql cli",
    "model": "dzql model",
    "model:load": "dzql model load ./src",
    "model:check": "dzql model built ./src",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@blueshed/delta": "^1.2.0",
    "@electric-sql/pglite": "^0.5.4",
    "dzql": "^0.14.0",
    "lucide": "^1.46.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.20.0"
  },
  "claudeSkills": [
    "dzql"
  ]
}
