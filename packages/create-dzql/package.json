{
  "name": "create-dzql",
  "version": "0.14.0",
  "description": "Create an app on dzql: eta's starter, its stories first, served by delta's one server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueshed/dzql.git",
    "directory": "packages/create-dzql"
  },
  "private": false,
