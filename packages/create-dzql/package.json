{
  "name": "create-dzql",
  "version": "0.14.0",
  "description": "Create an app on dzql: eta's starter, its stories first, served by delta's one server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueshed/dzql.git",
    "directory": "packages/create-dzql"
  },
  "private": false,
  "type": "module",
  "bin": {
    "create-dzql": "./cli.ts"
  },
  "files": [
    "cli.ts",
    "template",
    "!template/node_modules",
    "!template/data",
    "!template/.server.pid",
    "!template/db.sqlite*",
    "!template/.eta-session*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:fast": "bun test ./tests/ && cd template && bun check && bun --env-file=env.test test",
    "test": "bun run test:fast"
  },
  "devDependencies": {
    "dzql": "^0.14.0",
    "@blueshed/delta": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
