{
  "name": "@blueshed/railroad",
  "version": "0.16.2",
  "description": "The smallest reactive layer for Bun realtime apps \u2014 signals, JSX, hash router. Built so an LLM can use it correctly without re-learning. Pair with @blueshed/delta for WebSocket document sync.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./signals": "./signals.ts",
    "./jsx": "./jsx.ts",
    "./routes": "./routes.ts",
    "./shared": "./shared.ts",
    "./logger": "./logger.ts",
    "./webview": "./webview.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-dev-runtime.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "!*.test.tsx",
    "!happy-dom.setup.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".claude/skills"
  ],
  "scripts": {
    "check:consumer": "bun check -p tests/consumer-types/tsconfig.json && bun check -p tests/consumer-types/tsconfig.react.json && bun check -p tests/fixtures/readme/tsconfig.server.json",
    "test": "bun run test:fast",
    "test:webview": "bun test ./tests/webview.test.ts ./tests/webview-kit.test.ts",
    "test:fast": "bun check && bun test --path-ignore-patterns=\"tests/webview*.test.ts\"",
    "test:slow": "bun run check:consumer && bun run test:webview"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "^1.4.3"
  },
  "author": "Peter Bunyan <peter@blueshed.co.uk> (https://blueshed.co.uk)",
  "license": "MIT",
  "homepage": "https://github.com/blueshed/dzql/tree/main/packages/railroad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueshed/dzql.git",
    "directory": "packages/railroad"
  },
  "keywords": [
    "signals",
    "jsx",
    "router",
    "bun",
    "ui",
    "framework"
  ]
}
