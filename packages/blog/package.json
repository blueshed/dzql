{
  "name": "@dzql/blog",
  "version": "0.1.0",
  "description": "Example blog application built with DZQL",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "bun ../dzql/bin/cli.js compile entities/blog.sql -o init_db/",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "psql": "docker compose exec postgres psql -U dzql -d dzql_blog",
    "test": "bun test"
  },
  "keywords": ["dzql", "sample", "example", "compiler"],
  "author": "DZQL Team",
  "license": "MIT",
  "dependencies": {
    "dzql": "workspace:*"
  },
  "devDependencies": {
    "postgres": "^3.4.5"
  }
}
