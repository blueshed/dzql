{
  "name": "@dzql/blog",
  "version": "0.1.0",
  "description": "Example blog application built with DZQL",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "bun ../dzql/bin/cli.js compile entities/blog.sql -o init_db/",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:rebuild": "docker compose down -v && docker compose up -d && sleep 5 && bun run migrate:up",
    "psql": "docker compose exec postgres psql -U dzql -d dzql_blog",
    "migrate:new": "bun ../dzql/bin/cli.js migrate:new",
    "migrate:up": "DATABASE_URL=postgresql://dzql:dzql@localhost:5432/dzql_blog bun ../dzql/bin/cli.js migrate:up",
    "migrate:status": "DATABASE_URL=postgresql://dzql:dzql@localhost:5432/dzql_blog bun ../dzql/bin/cli.js migrate:status"
  },
  "keywords": ["dzql", "sample", "example", "compiler"],
  "author": "DZQL Team",
  "license": "MIT",
  "dependencies": {
    "dzql": "workspace:*"
  },
  "devDependencies": {
    "postgres": "^3.4.5"
  }
}
