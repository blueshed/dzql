{
  "version": "1.0",
  "name": "Venue Manager",
  "description": "Complete venue management interface",
  "initialState": {
    "activeView": "dashboard",
    "venues": {
      "searchText": "",
      "filters": {},
      "results": null,
      "selected": null,
      "editMode": false
    },
    "dashboard": {
      "stats": null,
      "recentVenues": null
    }
  },
  "onMount": [
    {
      "type": "call",
      "operation": "search",
      "entity": "venues",
      "params": {
        "limit": 5,
        "sort": {
          "field": "created_at",
          "order": "desc"
        }
      },
      "resultPath": "dashboard.recentVenues"
    }
  ],
  "ui": {
    "type": "container",
    "class": "venue-manager",
    "children": [
      {
        "type": "div",
        "class": "header",
        "children": [
          {
            "type": "h1",
            "text": "Venue Management System"
          },
          {
            "type": "div",
            "class": "nav-tabs",
            "children": [
              {
                "type": "button",
                "class": "${state.activeView === 'dashboard' ? 'tab active' : 'tab'}",
                "text": "Dashboard",
                "onClick": {
                  "actions": [
                    {
                      "type": "setState",
                      "path": "activeView",
                      "value": "dashboard"
                    }
                  ]
                }
              },
              {
                "type": "button",
                "class": "${state.activeView === 'venues' ? 'tab active' : 'tab'}",
                "text": "Venues",
                "onClick": {
                  "actions": [
                    {
                      "type": "setState",
                      "path": "activeView",
                      "value": "venues"
                    }
                  ]
                }
              },
              {
                "type": "button",
                "class": "${state.activeView === 'search' ? 'tab active' : 'tab'}",
                "text": "Advanced Search",
                "onClick": {
                  "actions": [
                    {
                      "type": "setState",
                      "path": "activeView",
                      "value": "search"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "content",
        "children": [
          {
            "type": "if",
            "condition": "${state.activeView === 'dashboard'}",
            "then": {
              "type": "section",
              "class": "dashboard",
              "children": [
                {
                  "type": "h2",
                  "text": "Dashboard"
                },
                {
                  "type": "div",
                  "class": "stats-grid",
                  "children": [
                    {
                      "type": "div",
                      "class": "stat-card",
                      "children": [
                        {
                          "type": "h3",
                          "text": "Total Venues"
                        },
                        {
                          "type": "div",
                          "class": "stat-value",
                          "text": "${state.dashboard.stats?.totalVenues || '...'}"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "class": "stat-card",
                      "children": [
                        {
                          "type": "h3",
                          "text": "Active Venues"
                        },
                        {
                          "type": "div",
                          "class": "stat-value",
                          "text": "${state.dashboard.stats?.activeVenues || '...'}"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "class": "stat-card",
                      "children": [
                        {
                          "type": "h3",
                          "text": "Total Capacity"
                        },
                        {
                          "type": "div",
                          "class": "stat-value",
                          "text": "${state.dashboard.stats?.totalCapacity || '...'}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "div",
                  "class": "recent-section",
                  "children": [
                    {
                      "type": "h3",
                      "text": "Recent Venues"
                    },
                    {
                      "type": "if",
                      "condition": "${state.dashboard.recentVenues}",
                      "then": {
                        "type": "table",
                        "data": "${state.dashboard.recentVenues.data}",
                        "columns": [
                          {
                            "field": "name",
                            "label": "Name"
                          },
                          {
                            "field": "city",
                            "label": "City"
                          },
                          {
                            "field": "capacity",
                            "label": "Capacity"
                          },
                          {
                            "field": "created_at",
                            "label": "Created"
                          }
                        ],
                        "onRowClick": {
                          "type": "setState",
                          "path": "venues.selected",
                          "value": "${row}"
                        }
                      },
                      "else": {
                        "type": "div",
                        "class": "loading",
                        "text": "Loading recent venues..."
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "if",
            "condition": "${state.activeView === 'venues'}",
            "then": {
              "type": "section",
              "class": "venues-section",
              "children": [
                {
                  "type": "div",
                  "class": "section-header",
                  "children": [
                    {
                      "type": "h2",
                      "text": "Venues"
                    },
                    {
                      "type": "button",
                      "text": "Add New Venue",
                      "class": "btn-primary",
                      "onClick": {
                        "actions": [
                          {
                            "type": "setState",
                            "path": "venues.editMode",
                            "value": true
                          },
                          {
                            "type": "setState",
                            "path": "venues.selected",
                            "value": {}
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "div",
                  "class": "search-bar",
                  "children": [
                    {
                      "type": "input",
                      "bind": "${state.venues.searchText}",
                      "attributes": {
                        "placeholder": "Search venues..."
                      },
                      "events": {
                        "keyup": {
                          "actions": [
                            {
                              "type": "call",
                              "operation": "search",
                              "entity": "venues",
                              "params": {
                                "filters": {
                                  "_search": "${state.venues.searchText}"
                                },
                                "limit": 25
                              },
                              "resultPath": "venues.results"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "button",
                      "text": "Search",
                      "onClick": {
                        "actions": [
                          {
                            "type": "call",
                            "operation": "search",
                            "entity": "venues",
                            "params": {
                              "filters": {
                                "_search": "${state.venues.searchText}"
                              },
                              "limit": 25
                            },
                            "resultPath": "venues.results"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "if",
                  "condition": "${state.venues.results}",
                  "then": {
                    "type": "div",
                    "children": [
                      {
                        "type": "p",
                        "text": "Found ${state.venues.results.total} venues"
                      },
                      {
                        "type": "table",
                        "data": "${state.venues.results.data}",
                        "columns": [
                          {
                            "field": "id",
                            "label": "ID"
                          },
                          {
                            "field": "name",
                            "label": "Name"
                          },
                          {
                            "field": "address",
                            "label": "Address"
                          },
                          {
                            "field": "city",
                            "label": "City"
                          },
                          {
                            "field": "capacity",
                            "label": "Capacity"
                          },
                          {
                            "field": "org.name",
                            "label": "Organisation"
                          }
                        ],
                        "onRowClick": {
                          "type": "setState",
                          "path": "venues.selected",
                          "value": "${row}"
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "if",
                  "condition": "${state.venues.editMode}",
                  "then": {
                    "type": "div",
                    "class": "modal-overlay",
                    "children": [
                      {
                        "type": "div",
                        "class": "modal",
                        "children": [
                          {
                            "type": "h3",
                            "text": "${state.venues.selected.id ? 'Edit Venue' : 'New Venue'}"
                          },
                          {
                            "type": "form",
                            "dataPath": "venues.formData",
                            "fields": [
                              {
                                "name": "name",
                                "label": "Venue Name",
                                "inputType": "text",
                                "bind": "${state.venues.selected.name}",
                                "required": true
                              },
                              {
                                "name": "address",
                                "label": "Address",
                                "inputType": "text",
                                "bind": "${state.venues.selected.address}"
                              },
                              {
                                "name": "city",
                                "label": "City",
                                "inputType": "text",
                                "bind": "${state.venues.selected.city}"
                              },
                              {
                                "name": "capacity",
                                "label": "Capacity",
                                "inputType": "number",
                                "bind": "${state.venues.selected.capacity}"
                              },
                              {
                                "name": "org_id",
                                "label": "Organisation",
                                "type": "select",
                                "bind": "${state.venues.selected.org_id}",
                                "lookup": {
                                  "entity": "organisations",
                                  "params": {}
                                }
                              }
                            ]
                          },
                          {
                            "type": "div",
                            "class": "modal-footer",
                            "children": [
                              {
                                "type": "button",
                                "text": "Cancel",
                                "class": "btn-secondary",
                                "onClick": {
                                  "actions": [
                                    {
                                      "type": "setState",
                                      "path": "venues.editMode",
                                      "value": false
                                    }
                                  ]
                                }
                              },
                              {
                                "type": "button",
                                "text": "Save",
                                "class": "btn-primary",
                                "onClick": {
                                  "actions": [
                                    {
                                      "type": "call",
                                      "operation": "save",
                                      "entity": "venues",
                                      "params": "${state.venues.selected}",
                                      "onSuccess": [
                                        {
                                          "type": "setState",
                                          "path": "venues.editMode",
                                          "value": false
                                        },
                                        {
                                          "type": "call",
                                          "operation": "search",
                                          "entity": "venues",
                                          "params": {
                                            "filters": {
                                              "_search": "${state.venues.searchText}"
                                            },
                                            "limit": 25
                                          },
                                          "resultPath": "venues.results"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "type": "if",
            "condition": "${state.activeView === 'search'}",
            "then": {
              "type": "section",
              "class": "search-section",
              "children": [
                {
                  "type": "h2",
                  "text": "Advanced Search"
                },
                {
                  "type": "div",
                  "class": "search-filters",
                  "children": [
                    {
                      "type": "div",
                      "class": "filter-group",
                      "children": [
                        {
                          "type": "label",
                          "text": "Name"
                        },
                        {
                          "type": "input",
                          "bind": "${state.venues.filters.name}"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "class": "filter-group",
                      "children": [
                        {
                          "type": "label",
                          "text": "City"
                        },
                        {
                          "type": "input",
                          "bind": "${state.venues.filters.city}"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "class": "filter-group",
                      "children": [
                        {
                          "type": "label",
                          "text": "Min Capacity"
                        },
                        {
                          "type": "input",
                          "inputType": "number",
                          "bind": "${state.venues.filters.minCapacity}"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "class": "filter-group",
                      "children": [
                        {
                          "type": "label",
                          "text": "Max Capacity"
                        },
                        {
                          "type": "input",
                          "inputType": "number",
                          "bind": "${state.venues.filters.maxCapacity}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "button",
                  "text": "Apply Filters",
                  "class": "btn-primary",
                  "onClick": {
                    "actions": [
                      {
                        "type": "call",
                        "operation": "search",
                        "entity": "venues",
                        "params": {
                          "filters": {
                            "name": "${state.venues.filters.name ? {ilike: '%' + state.venues.filters.name + '%'} : undefined}",
                            "city": "${state.venues.filters.city}",
                            "capacity": "${state.venues.filters.minCapacity && state.venues.filters.maxCapacity ? {gte: state.venues.filters.minCapacity, lte: state.venues.filters.maxCapacity} : state.venues.filters.minCapacity ? {gte: state.venues.filters.minCapacity} : state.venues.filters.maxCapacity ? {lte: state.venues.filters.maxCapacity} : undefined}"
                          },
                          "limit": 50
                        },
                        "resultPath": "venues.searchResults"
                      }
                    ]
                  }
                },
                {
                  "type": "if",
                  "condition": "${state.venues.searchResults}",
                  "then": {
                    "type": "div",
                    "children": [
                      {
                        "type": "p",
                        "text": "Found ${state.venues.searchResults.total} matching venues"
                      },
                      {
                        "type": "table",
                        "data": "${state.venues.searchResults.data}",
                        "columns": [
                          {
                            "field": "name",
                            "label": "Name"
                          },
                          {
                            "field": "address",
                            "label": "Address"
                          },
                          {
                            "field": "city",
                            "label": "City"
                          },
                          {
                            "field": "capacity",
                            "label": "Capacity"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "components": {
    "VenueCard": {
      "template": {
        "type": "div",
        "class": "venue-card",
        "children": [
          {
            "type": "h3",
            "text": "${props.venue.name}"
          },
          {
            "type": "p",
            "text": "${props.venue.address}"
          },
          {
            "type": "p",
            "text": "Capacity: ${props.venue.capacity}"
          }
        ]
      }
    }
  }
}
