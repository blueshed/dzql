CREATE OR REPLACE FUNCTION dzql_open_whole__fo_guest(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 10), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_households" t WHERE (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."email" = v_s2::TEXT);
    v_doc := jsonb_build_object('households', v_rows);
  ELSE
    SELECT to_jsonb(t.*) INTO v_root FROM "fo_households" t WHERE t.id = v_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."email" = v_s2::TEXT);
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('households', v_root);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_seat_of(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 12), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  IF v_s2 IS NOT NULL THEN
    IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    ELSIF abs(v_s2::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    END IF;
  END IF;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_seats" t WHERE (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."table_no" = v_s2::BIGINT);
    v_doc := jsonb_build_object('seats', v_rows);
  ELSE
    SELECT to_jsonb(t.*) INTO v_root FROM "fo_seats" t WHERE t.id = v_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."table_no" = v_s2::BIGINT);
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('seats', v_root);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

