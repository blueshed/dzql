END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_tags_labelled(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 18), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_tags" t WHERE (v_s1 IS NULL OR t."label" = v_s1::TEXT);
  v_doc := jsonb_build_object('tags', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_seating(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 12);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_weddings" t WHERE TRUE;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) FROM "fo_seats" t));
  ELSE
    SELECT to_jsonb(t.*) INTO v_root FROM "fo_weddings" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) FROM "fo_seats" t WHERE t."weddings_id" = v_id));
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_seats_kept(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    BEGIN
      PERFORM v_s1::BOOLEAN;
    EXCEPTION WHEN invalid_text_representation THEN
      RAISE EXCEPTION 'kept must be a boolean (true/false, yes/no, on/off, 1/0, or a prefix), not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_seats" t WHERE (v_s1 IS NULL OR t."kept" = v_s1::BOOLEAN);
  v_doc := jsonb_build_object('seats', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_seats_upto(p_name TEXT)
