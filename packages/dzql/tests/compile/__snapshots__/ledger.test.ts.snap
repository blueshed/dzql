  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 14), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  SELECT COALESCE(jsonb_object_agg(t.id, (to_jsonb(t.*) - 'valid_from' - 'valid_to' - 'override')), '{}'::jsonb) INTO v_rows FROM "order" t WHERE (v_s1 IS NULL OR t."from" = v_s1::TEXT) AND (CASE WHEN p_at IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= p_at AND (t.valid_to IS NULL OR t.valid_to > p_at) END);
  v_doc := jsonb_build_object('asks', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_whole__fo_pub_courses(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 16);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_courses" t WHERE TRUE;
    v_doc := jsonb_build_object('courses', v_rows);
  ELSE
    SELECT to_jsonb(t.*) INTO v_root FROM "fo_courses" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('courses', v_root);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION _delta_open(p_doc_name TEXT, p_whole BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_def _delta_docs := _delta_find_doc(p_doc_name);
BEGIN
  CASE v_def.prefix
    WHEN 'fo-board:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_board(p_doc_name) ELSE dzql_open__fo_board(p_doc_name) END;
    WHEN 'fo-menu:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_menu(p_doc_name) ELSE dzql_open__fo_menu(p_doc_name) END;
    WHEN 'fo-household:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_household(p_doc_name) ELSE dzql_open__fo_household(p_doc_name) END;
    WHEN 'fo-course:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_course(p_doc_name) ELSE dzql_open__fo_course(p_doc_name) END;
    WHEN 'fo-title:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_title(p_doc_name) ELSE dzql_open__fo_title(p_doc_name) END;
    WHEN 'fo-tagged:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_tagged(p_doc_name) ELSE dzql_open__fo_tagged(p_doc_name) END;
    WHEN 'fo-notes:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_notes(p_doc_name) ELSE dzql_open__fo_notes(p_doc_name) END;
    WHEN 'fo-all-courses:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_all_courses(p_doc_name) ELSE dzql_open__fo_all_courses(p_doc_name) END;
    WHEN 'fo-catalog:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_catalog(p_doc_name) ELSE dzql_open__fo_catalog(p_doc_name) END;
    WHEN 'fo-courses-noted:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_courses_noted(p_doc_name) ELSE dzql_open__fo_courses_noted(p_doc_name) END;
    WHEN 'fo-courses-like:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_courses_like(p_doc_name) ELSE dzql_open__fo_courses_like(p_doc_name) END;
    WHEN 'fo-menu-like:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_menu_like(p_doc_name) ELSE dzql_open__fo_menu_like(p_doc_name) END;
    WHEN 'fo-tags-labelled:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_tags_labelled(p_doc_name) ELSE dzql_open__fo_tags_labelled(p_doc_name) END;
    WHEN 'fo-seating:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seating(p_doc_name) ELSE dzql_open__fo_seating(p_doc_name) END;
    WHEN 'fo-seats-kept:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seats_kept(p_doc_name) ELSE dzql_open__fo_seats_kept(p_doc_name) END;
    WHEN 'fo-seats-upto:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seats_upto(p_doc_name) ELSE dzql_open__fo_seats_upto(p_doc_name) END;
    WHEN 'fo-seats-at:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seats_at(p_doc_name) ELSE dzql_open__fo_seats_at(p_doc_name) END;
    WHEN 'fo-seats-wished:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seats_wished(p_doc_name) ELSE dzql_open__fo_seats_wished(p_doc_name) END;
    WHEN 'fo-slots-upto:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slots_upto(p_doc_name) ELSE dzql_open__fo_slots_upto(p_doc_name) END;
    WHEN 'fo-slots-of:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slots_of(p_doc_name) ELSE dzql_open__fo_slots_of(p_doc_name) END;
    WHEN 'fo-slots-under:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slots_under(p_doc_name) ELSE dzql_open__fo_slots_under(p_doc_name) END;
    WHEN 'fo-slots-by:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slots_by(p_doc_name) ELSE dzql_open__fo_slots_by(p_doc_name) END;
    WHEN 'fo-slots-on:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slots_on(p_doc_name) ELSE dzql_open__fo_slots_on(p_doc_name) END;
    WHEN 'fo-note:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_note(p_doc_name) ELSE dzql_open__fo_note(p_doc_name) END;
    WHEN 'fo-all-notes:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_all_notes(p_doc_name) ELSE dzql_open__fo_all_notes(p_doc_name) END;
    WHEN 'fo-drinks:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_drinks(p_doc_name) ELSE dzql_open__fo_drinks(p_doc_name) END;
    WHEN 'fo-course-guests:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_course_guests(p_doc_name) ELSE dzql_open__fo_course_guests(p_doc_name) END;
    WHEN 'fo-plan:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_plan(p_doc_name) ELSE dzql_open__fo_plan(p_doc_name) END;
    WHEN 'fo-weddings:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_weddings(p_doc_name) ELSE dzql_open__fo_weddings(p_doc_name) END;
    WHEN 'fo-guest:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_guest(p_doc_name) ELSE dzql_open__fo_guest(p_doc_name) END;
    WHEN 'fo-seat-of:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_seat_of(p_doc_name) ELSE dzql_open__fo_seat_of(p_doc_name) END;
    WHEN 'fo-all-households:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_all_households(p_doc_name) ELSE dzql_open__fo_all_households(p_doc_name) END;
    WHEN 'fo-party:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_party(p_doc_name) ELSE dzql_open__fo_party(p_doc_name) END;
    WHEN 'fo-slim:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_slim(p_doc_name) ELSE dzql_open__fo_slim(p_doc_name) END;
    WHEN 'fo-notes-on:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_notes_on(p_doc_name) ELSE dzql_open__fo_notes_on(p_doc_name) END;
    WHEN 'fo-courses-noted-on:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_courses_noted_on(p_doc_name) ELSE dzql_open__fo_courses_noted_on(p_doc_name) END;
    WHEN 'fo-board-on:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_board_on(p_doc_name) ELSE dzql_open__fo_board_on(p_doc_name) END;
    WHEN 'fo-asks:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_asks(p_doc_name) ELSE dzql_open__fo_asks(p_doc_name) END;
    WHEN 'fo-asks-from:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_asks_from(p_doc_name) ELSE dzql_open__fo_asks_from(p_doc_name) END;
    WHEN 'fo-pub-courses:' THEN RETURN CASE WHEN p_whole THEN dzql_open_whole__fo_pub_courses(p_doc_name) ELSE dzql_open__fo_pub_courses(p_doc_name) END;
    ELSE RETURN _delta_open_framework(p_doc_name, p_whole);   -- a name no document compiled here holds (none at all: the framework refuses it)
  END CASE;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION _delta_same(p_coll TEXT, p_field TEXT, a JSONB, b JSONB)
RETURNS BOOLEAN AS $$
DECLARE
  v_declared JSONB;
  v_type     TEXT;
BEGIN
  IF jsonb_typeof(a) = 'string' AND jsonb_typeof(b) = 'string' THEN
    CASE p_coll
      WHEN 'weddings' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'weddings';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'households' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'households';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'courses' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'courses';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'drinks' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'drinks';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'tags' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'tags';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'notes' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'notes';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'seats' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'seats';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'slots' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'slots';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' WHEN p_field IN ('starts') THEN 'timestamptz' END;
      WHEN 'favours' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'favours';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      WHEN 'asks' THEN
        v_declared := NULLIF(current_setting('delta.declared', true), '')::jsonb -> 'asks';
        v_type := CASE WHEN v_declared IS NOT NULL THEN v_declared -> p_field ->> 'type' END;
      ELSE RETURN _delta_same_framework(p_coll, p_field, a, b);
    END CASE;
    IF v_type = 'timestamptz' THEN RETURN (a #>> '{}')::timestamptz = (b #>> '{}')::timestamptz; END IF;
  END IF;
  RETURN COALESCE(a, 'null'::jsonb) = COALESCE(b, 'null'::jsonb);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_row_standing(p_coll TEXT, p_id BIGINT)
RETURNS JSONB AS $$
BEGIN
  CASE p_coll
    WHEN 'weddings' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_weddings" t WHERE t.id = p_id));
    WHEN 'households' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_households" t WHERE t.id = p_id));
    WHEN 'courses' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_courses" t WHERE t.id = p_id));
    WHEN 'drinks' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_drinks" t WHERE t.id = p_id));
    WHEN 'tags' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_tags" t WHERE t.id = p_id));
    WHEN 'notes' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "current_fo_notes" t WHERE t.id = p_id));
    WHEN 'seats' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_seats" t WHERE t.id = p_id));
    WHEN 'slots' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_slots" t WHERE t.id = p_id));
    WHEN 'favours' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "fo_favours" t WHERE t.id = p_id));
    WHEN 'asks' THEN RETURN jsonb_build_object('row', (SELECT _delta_strip_temporal(to_jsonb(t.*)) FROM "current_order" t WHERE t.id = p_id));
    ELSE RETURN _delta_row_standing_framework(p_coll, p_id);
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
`;
