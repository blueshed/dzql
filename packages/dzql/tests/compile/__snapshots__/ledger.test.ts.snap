BEGIN
  v_parts := string_to_array(substring(p_name FROM 17), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    BEGIN
      PERFORM v_s1::JSONB;
    EXCEPTION WHEN invalid_text_representation THEN
      RAISE EXCEPTION 'wishes must be JSON, not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_seats" t WHERE (v_s1 IS NULL OR t."wishes" = v_s1::JSONB);
  v_doc := jsonb_build_object('seats', v_rows);
