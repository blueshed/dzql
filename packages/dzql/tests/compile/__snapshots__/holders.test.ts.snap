           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 8 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_menu(v_cand, 'weddings', p_row) THEN
