exports[`the compiled text is the same for the same definitions, and pinned 1`] = `
"CREATE OR REPLACE FUNCTION _delta_holders(p_coll TEXT, p_row JSONB, p_writer TEXT)
RETURNS TEXT[] AS $$
DECLARE
  v_names TEXT[] := ARRAY[]::text[];
  v_rid   BIGINT;
  v_cand  TEXT;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'a delta write runs at READ COMMITTED, not %: a document opened while it ran would not be told of it',
      upper(current_setting('transaction_isolation')) USING ERRCODE = '0A000';
  END IF;
  IF p_row IS NULL THEN RETURN v_names; END IF;
  PERFORM set_config('dzql.definer', 'on', true);   -- the rows a chain climbs, past the policies: names come back, never a row (compilePolicies)
  CASE p_coll
    WHEN 'weddings' THEN
      -- fo-board:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-board:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-board:', 'fo-board:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-board:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND dzql_holds__fo_board(v_cand, 'weddings', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-menu:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-menu:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-menu:', 'fo-menu:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-menu:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND dzql_holds__fo_menu(v_cand, 'weddings', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-title:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-title:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-title:', 'fo-title:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-title:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND dzql_holds__fo_title(v_cand, 'weddings', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-tagged:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-tagged:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-tagged:', 'fo-tagged:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-tagged:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND dzql_holds__fo_tagged(v_cand, 'weddings', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-notes:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-notes:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-notes:', 'fo-notes:' || v_rid::text)
        UNION
