"CREATE OR REPLACE FUNCTION _delta_holders(p_coll TEXT, p_row JSONB, p_writer TEXT)
RETURNS TEXT[] AS $$
DECLARE
  v_names TEXT[] := ARRAY[]::text[];
  v_rid   BIGINT;
  v_cand  TEXT;
BEGIN
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'a delta write runs at READ COMMITTED, not %: a document opened while it ran would not be told of it',
      upper(current_setting('transaction_isolation')) USING ERRCODE = '0A000';
  END IF;
  IF p_row IS NULL THEN RETURN v_names; END IF;
  CASE p_coll
    WHEN 'weddings' THEN
      -- fo-board:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-board:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-board:', 'fo-board:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-board:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 9 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_board(v_cand, 'weddings', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-menu:
      v_rid := (p_row->>'id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-menu:'));
