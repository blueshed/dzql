      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-slots-under:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE starts_with(doc_name, 'fo-slots-under:')
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-slots-under:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 15 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_slots_under(v_cand, 'slots', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-slots-by:
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-slots-by:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE starts_with(doc_name, 'fo-slots-by:')
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-slots-by:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 12 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_slots_by(v_cand, 'slots', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-slots-on:
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-slots-on:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE starts_with(doc_name, 'fo-slots-on:')
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-slots-on:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 12 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_slots_on(v_cand, 'slots', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
    WHEN 'favours' THEN
      -- fo-party:
      v_rid := (p_row->>'weddings_id')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-party:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-party:', 'fo-party:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-party:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 9 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_party(v_cand, 'favours', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
    WHEN 'asks' THEN
      -- fo-asks:
      v_rid := (p_row->>'group')::BIGINT;
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-asks:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE doc_name IN ('fo-asks:', 'fo-asks:' || v_rid::text)
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-asks:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 8 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_asks(v_cand, 'asks', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
      -- fo-asks-from:
      PERFORM pg_advisory_xact_lock_shared(hashtext('_delta_hold'), hashtext('fo-asks-from:'));
      FOR v_cand IN
        SELECT doc_name FROM _delta_held WHERE starts_with(doc_name, 'fo-asks-from:')
        UNION
        SELECT p_writer WHERE p_writer IS NOT NULL AND starts_with(p_writer, 'fo-asks-from:')
      LOOP
        IF NOT (v_cand = ANY(v_names))
           AND NOT EXISTS (SELECT 1 FROM _delta_docs d WHERE length(d.prefix) > 13 AND starts_with(v_cand, d.prefix))   -- the longest prefix owns the name
           AND dzql_holds__fo_asks_from(v_cand, 'asks', p_row) THEN
          v_names := v_names || v_cand;
        END IF;
      END LOOP;
    ELSE NULL;
  END CASE;
  -- the documents not compiled here, as the framework asks them
  IF EXISTS (SELECT 1 FROM _delta_docs WHERE (root_collection = p_coll OR p_coll = ANY(include)) AND NOT (prefix = ANY(ARRAY['fo-board:', 'fo-menu:', 'fo-household:', 'fo-course:', 'fo-title:', 'fo-tagged:', 'fo-notes:', 'fo-all-courses:', 'fo-catalog:', 'fo-courses-noted:', 'fo-courses-like:', 'fo-menu-like:', 'fo-tags-labelled:', 'fo-seating:', 'fo-seats-kept:', 'fo-seats-upto:', 'fo-seats-at:', 'fo-seats-wished:', 'fo-slots-upto:', 'fo-slots-of:', 'fo-slots-under:', 'fo-slots-by:', 'fo-slots-on:', 'fo-note:', 'fo-all-notes:', 'fo-drinks:', 'fo-course-guests:', 'fo-plan:', 'fo-weddings:', 'fo-guest:', 'fo-seat-of:', 'fo-all-households:', 'fo-party:', 'fo-slim:', 'fo-notes-on:', 'fo-courses-noted-on:', 'fo-board-on:', 'fo-asks:', 'fo-asks-from:', 'fo-pub-courses:']::text[]))) THEN
    v_names := v_names || _delta_holders_framework(p_coll, p_row, p_writer, ARRAY['fo-board:', 'fo-menu:', 'fo-household:', 'fo-course:', 'fo-title:', 'fo-tagged:', 'fo-notes:', 'fo-all-courses:', 'fo-catalog:', 'fo-courses-noted:', 'fo-courses-like:', 'fo-menu-like:', 'fo-tags-labelled:', 'fo-seating:', 'fo-seats-kept:', 'fo-seats-upto:', 'fo-seats-at:', 'fo-seats-wished:', 'fo-slots-upto:', 'fo-slots-of:', 'fo-slots-under:', 'fo-slots-by:', 'fo-slots-on:', 'fo-note:', 'fo-all-notes:', 'fo-drinks:', 'fo-course-guests:', 'fo-plan:', 'fo-weddings:', 'fo-guest:', 'fo-seat-of:', 'fo-all-households:', 'fo-party:', 'fo-slim:', 'fo-notes-on:', 'fo-courses-noted-on:', 'fo-board-on:', 'fo-asks:', 'fo-asks-from:', 'fo-pub-courses:']::text[]);
  END IF;
  RETURN v_names;
END;
$$ LANGUAGE plpgsql VOLATILE SECURITY DEFINER;
DO $$ BEGIN
  EXECUTE format('ALTER FUNCTION _delta_holders(TEXT, JSONB, TEXT) SET search_path = %s, pg_temp', COALESCE(NULLIF(current_setting('search_path'), ''), 'public'));
END $$;
"
`;
