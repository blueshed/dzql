  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
