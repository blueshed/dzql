  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'slots' THEN RETURN EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."starts" = v_s1::TIMESTAMPTZ)); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN FALSE;
      WHEN 'drinks' THEN RETURN FALSE;
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = v_id AND (v_s1 IS NULL OR t."starts" = v_s1::TIMESTAMPTZ));
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

