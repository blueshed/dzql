CREATE OR REPLACE FUNCTION dzql_in_scope__fo_courses_like(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 17), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'courses' THEN RETURN EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."name" ILIKE v_s1 || '%')); END IF;
    CASE p_coll
        WHEN 'drinks' THEN RETURN EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = (SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id) AND (v_s1 IS NULL OR t."name" ILIKE v_s1 || '%'));
      ELSE RETURN TRUE;
    END CASE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = v_id AND (v_s1 IS NULL OR t."name" ILIKE v_s1 || '%'));
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = v_id AND (v_s1 IS NULL OR t."name" ILIKE v_s1 || '%'));
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN FALSE;
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

