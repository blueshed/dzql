    IF p_coll IS NOT DISTINCT FROM 'slots' THEN RETURN EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = p_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."weddings_id" <= v_s1::BIGINT ELSE t."weddings_id" IS NOT NULL END))); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN FALSE;
