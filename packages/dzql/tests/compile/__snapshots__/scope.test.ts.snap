CREATE OR REPLACE FUNCTION dzql_in_scope__fo_notes_on(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    v_date := regexp_match(v_s1, '^\\s*([0-9]{4})-([0-9]{2})-([0-9]{2})\\s*$');
    IF v_date IS NULL OR v_date[1]::int < 1 OR v_date[2]::int NOT BETWEEN 1 AND 12 THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF v_date[3]::int NOT BETWEEN 1 AND extract(day FROM make_date(v_date[1]::int, v_date[2]::int, 1) + interval '1 month - 1 day')::int THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
    v_s1 := format('%s-%s-%s 00:00:00+00', v_date[1], v_date[2], v_date[3]);
  END IF;
  IF v_s1 IS NOT NULL THEN p_at := v_s1::TIMESTAMPTZ; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'notes' THEN RETURN EXISTS (SELECT 1 FROM "fo_notes" t WHERE t.id = p_id AND t.valid_to IS NULL); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN FALSE;
      WHEN 'drinks' THEN RETURN FALSE;
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_notes" t WHERE t.id = v_id AND t.valid_to IS NULL);
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN FALSE;
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_in_scope__fo_courses_noted_on(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 21), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    v_date := regexp_match(v_s1, '^\\s*([0-9]{4})-([0-9]{2})-([0-9]{2})\\s*$');
    IF v_date IS NULL OR v_date[1]::int < 1 OR v_date[2]::int NOT BETWEEN 1 AND 12 THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF v_date[3]::int NOT BETWEEN 1 AND extract(day FROM make_date(v_date[1]::int, v_date[2]::int, 1) + interval '1 month - 1 day')::int THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
    v_s1 := format('%s-%s-%s 00:00:00+00', v_date[1], v_date[2], v_date[3]);
  END IF;
  IF v_s1 IS NOT NULL THEN p_at := v_s1::TIMESTAMPTZ; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'courses' THEN RETURN EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = p_id); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = v_id);
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = v_id);
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN FALSE;
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_in_scope__fo_board_on(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_s2 TEXT;
  v_n2 BOOLEAN;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[2], '');
  IF v_s1 IS NOT NULL THEN
    v_date := regexp_match(v_s1, '^\\s*([0-9]{4})-([0-9]{2})-([0-9]{2})\\s*$');
    IF v_date IS NULL OR v_date[1]::int < 1 OR v_date[2]::int NOT BETWEEN 1 AND 12 THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF v_date[3]::int NOT BETWEEN 1 AND extract(day FROM make_date(v_date[1]::int, v_date[2]::int, 1) + interval '1 month - 1 day')::int THEN
      RAISE EXCEPTION 'at must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
    v_s1 := format('%s-%s-%s 00:00:00+00', v_date[1], v_date[2], v_date[3]);
  END IF;
  IF v_s1 IS NOT NULL THEN p_at := v_s1::TIMESTAMPTZ; END IF;
  v_s2 := NULLIF(v_parts[1], '');
  IF v_s2 IS NOT NULL THEN
    IF v_s2 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s2 USING ERRCODE = '22P02';
      ELSIF abs(v_s2::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s2 USING ERRCODE = '22P02';
      END IF;
      v_n2 := TRUE;
    ELSIF v_s2 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s2 USING ERRCODE = '22P02';
    ELSE
      v_n2 := FALSE;
    END IF;
  END IF;
  IF v_s2 IS NOT NULL THEN v_single := TRUE; v_id := v_s2::BIGINT; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'weddings' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = p_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END))); END IF;
    CASE p_coll
        WHEN 'households' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_households" x WHERE x.id = p_id) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'courses' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = p_id) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'drinks' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = (SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id)) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'notes' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_notes" x WHERE x.id = p_id AND x.valid_to IS NULL) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'seats' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_seats" x WHERE x.id = p_id) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'slots' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_slots" x WHERE x.id = p_id) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'favours' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."weddings_id" FROM "fo_favours" x WHERE x.id = p_id) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
        WHEN 'asks' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = (SELECT x."group" FROM "order" x WHERE x.id = p_id AND x.valid_to IS NULL) AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      ELSE RETURN TRUE;
    END CASE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'households' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_households" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'courses' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = (SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id)) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_notes" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'seats' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_seats" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'slots' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_slots" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'favours' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_favours" x WHERE x.id = p_id) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
      WHEN 'asks' THEN RETURN COALESCE((SELECT x."group" FROM "order" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = v_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_in_scope__fo_asks(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rest TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_rest := substring(p_name FROM 9);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'weddings' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = p_id); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN COALESCE(p_id = v_id, FALSE);
      WHEN 'households' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_households" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'courses' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = (SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id)) = v_id, FALSE);
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_notes" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE);
      WHEN 'seats' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_seats" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'slots' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_slots" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'favours' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_favours" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'asks' THEN RETURN COALESCE((SELECT x."group" FROM "order" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE);
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_in_scope__fo_asks_from(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 14), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'asks' THEN RETURN EXISTS (SELECT 1 FROM "order" t WHERE t.id = p_id AND t.valid_to IS NULL AND (v_s1 IS NULL OR t."from" = v_s1::TEXT)); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN FALSE;
      WHEN 'drinks' THEN RETURN FALSE;
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN FALSE;
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "order" t WHERE t.id = v_id AND t.valid_to IS NULL AND (v_s1 IS NULL OR t."from" = v_s1::TEXT));
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_in_scope__fo_pub_courses(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rest TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_rest := substring(p_name FROM 16);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'courses' THEN RETURN EXISTS (SELECT 1 FROM "fo_courses" t WHERE t.id = p_id); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN COALESCE(p_id = v_id, FALSE);
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN FALSE;
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_row_in_scope(p_def _delta_docs, p_doc_name TEXT, p_collection_key TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
BEGIN
  CASE p_def.prefix
    WHEN 'fo-board:' THEN RETURN dzql_in_scope__fo_board(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-menu:' THEN RETURN dzql_in_scope__fo_menu(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-household:' THEN RETURN dzql_in_scope__fo_household(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-course:' THEN RETURN dzql_in_scope__fo_course(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-title:' THEN RETURN dzql_in_scope__fo_title(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-tagged:' THEN RETURN dzql_in_scope__fo_tagged(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-notes:' THEN RETURN dzql_in_scope__fo_notes(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-all-courses:' THEN RETURN dzql_in_scope__fo_all_courses(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-catalog:' THEN RETURN dzql_in_scope__fo_catalog(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-courses-noted:' THEN RETURN dzql_in_scope__fo_courses_noted(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-courses-like:' THEN RETURN dzql_in_scope__fo_courses_like(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-menu-like:' THEN RETURN dzql_in_scope__fo_menu_like(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-tags-labelled:' THEN RETURN dzql_in_scope__fo_tags_labelled(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seating:' THEN RETURN dzql_in_scope__fo_seating(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seats-kept:' THEN RETURN dzql_in_scope__fo_seats_kept(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seats-upto:' THEN RETURN dzql_in_scope__fo_seats_upto(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seats-at:' THEN RETURN dzql_in_scope__fo_seats_at(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seats-wished:' THEN RETURN dzql_in_scope__fo_seats_wished(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slots-upto:' THEN RETURN dzql_in_scope__fo_slots_upto(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slots-of:' THEN RETURN dzql_in_scope__fo_slots_of(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slots-under:' THEN RETURN dzql_in_scope__fo_slots_under(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slots-by:' THEN RETURN dzql_in_scope__fo_slots_by(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slots-on:' THEN RETURN dzql_in_scope__fo_slots_on(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-note:' THEN RETURN dzql_in_scope__fo_note(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-all-notes:' THEN RETURN dzql_in_scope__fo_all_notes(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-drinks:' THEN RETURN dzql_in_scope__fo_drinks(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-course-guests:' THEN RETURN dzql_in_scope__fo_course_guests(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-plan:' THEN RETURN dzql_in_scope__fo_plan(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-weddings:' THEN RETURN dzql_in_scope__fo_weddings(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-guest:' THEN RETURN dzql_in_scope__fo_guest(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-seat-of:' THEN RETURN dzql_in_scope__fo_seat_of(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-all-households:' THEN RETURN dzql_in_scope__fo_all_households(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-party:' THEN RETURN dzql_in_scope__fo_party(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-slim:' THEN RETURN dzql_in_scope__fo_slim(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-notes-on:' THEN RETURN dzql_in_scope__fo_notes_on(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-courses-noted-on:' THEN RETURN dzql_in_scope__fo_courses_noted_on(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-board-on:' THEN RETURN dzql_in_scope__fo_board_on(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-asks:' THEN RETURN dzql_in_scope__fo_asks(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-asks-from:' THEN RETURN dzql_in_scope__fo_asks_from(p_doc_name, p_collection_key, p_id);
    WHEN 'fo-pub-courses:' THEN RETURN dzql_in_scope__fo_pub_courses(p_doc_name, p_collection_key, p_id);
    ELSE RAISE EXCEPTION 'no doc def for: %', p_doc_name USING ERRCODE = 'P0001';
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
