exports[`the compiled text is the same for the same definitions, and pinned 1`] = `
"CREATE OR REPLACE FUNCTION dzql_in_scope__fo_board(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rest TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_rest := substring(p_name FROM 10);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'weddings' THEN RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = p_id); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN COALESCE(p_id = v_id, FALSE);
      WHEN 'households' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_households" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'courses' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'drinks' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_courses" x WHERE x.id = (SELECT x."courses_id" FROM "fo_drinks" x WHERE x.id = p_id)) = v_id, FALSE);
      WHEN 'tags' THEN RETURN TRUE;
      WHEN 'notes' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_notes" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE);
      WHEN 'seats' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_seats" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'slots' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_slots" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'favours' THEN RETURN COALESCE((SELECT x."weddings_id" FROM "fo_favours" x WHERE x.id = p_id) = v_id, FALSE);
      WHEN 'asks' THEN RETURN COALESCE((SELECT x."group" FROM "order" x WHERE x.id = p_id AND x.valid_to IS NULL) = v_id, FALSE);
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

