CREATE OR REPLACE FUNCTION dzql_in_scope__fo_slots_by(p_name TEXT, p_coll TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_id IS NULL THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    v_date := regexp_match(v_s1, '^\\s*([0-9]{4})-([0-9]{2})-([0-9]{2})\\s*$');
    IF v_date IS NULL OR v_date[1]::int < 1 OR v_date[2]::int NOT BETWEEN 1 AND 12 THEN
      RAISE EXCEPTION 'starts must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF v_date[3]::int NOT BETWEEN 1 AND extract(day FROM make_date(v_date[1]::int, v_date[2]::int, 1) + interval '1 month - 1 day')::int THEN
      RAISE EXCEPTION 'starts must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
    v_s1 := format('%s-%s-%s 00:00:00+00', v_date[1], v_date[2], v_date[3]);
  END IF;
  IF NOT v_single THEN
    -- a list holds its root rows by the name's conditions, a row that hangs from its root under one of those, any other whole
    IF p_coll IS NOT DISTINCT FROM 'slots' THEN RETURN EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."starts" <= v_s1::TIMESTAMPTZ)); END IF;
    RETURN TRUE;
  END IF;
  CASE p_coll
      WHEN 'weddings' THEN RETURN FALSE;
      WHEN 'households' THEN RETURN FALSE;
      WHEN 'courses' THEN RETURN FALSE;
      WHEN 'drinks' THEN RETURN FALSE;
      WHEN 'tags' THEN RETURN FALSE;
      WHEN 'notes' THEN RETURN FALSE;
      WHEN 'seats' THEN RETURN FALSE;
      WHEN 'slots' THEN RETURN COALESCE(p_id = v_id, FALSE) AND EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = v_id AND (v_s1 IS NULL OR t."starts" <= v_s1::TIMESTAMPTZ));
      WHEN 'favours' THEN RETURN FALSE;
      WHEN 'asks' THEN RETURN FALSE;
    ELSE RETURN FALSE;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

