CREATE OR REPLACE FUNCTION dzql_scope__fo_seats_at(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_where  TEXT := '';
  v_values JSONB := '{}'::jsonb;
  v_at     TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN IF p_refuse THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('table_no must be an integer, not "%s"', v_s1));
    ELSIF abs(v_s1::numeric) > 9007199254740991 THEN IF p_refuse THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('table_no must be an integer, not "%s"', v_s1));
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_where := v_where || CASE WHEN v_where <> '' THEN ' AND ' ELSE '' END || format('%I = %L', 'table_no', v_s1); END IF;
  IF v_s1 IS NOT NULL THEN v_values := v_values || jsonb_build_object('table_no', v_s1); END IF;
  IF v_where = '' THEN v_where := 'TRUE'; END IF;
  RETURN jsonb_build_object('where', v_where, 'values', v_values, 'mode', CASE WHEN v_values ? 'id' THEN 'single' ELSE 'list' END, 'at', v_at);
END;
$$ LANGUAGE plpgsql STABLE;

