    IF v_s2 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN IF p_refuse THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s2 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('id %s is past 2^53 - 1, which no number holds exactly', v_s2));
      ELSIF abs(v_s2::numeric) > 9007199254740991 THEN IF p_refuse THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s2 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('id %s is past 2^53 - 1, which no number holds exactly', v_s2));
      END IF;
      v_n2 := TRUE;
    ELSIF v_s2 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      IF p_refuse THEN RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s2 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('id must be an id -- a whole number, or text -- not "%s"', v_s2));
    ELSE
      v_n2 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_at := v_s1; END IF;
  IF v_s2 IS NOT NULL THEN v_where := v_where || CASE WHEN v_where <> '' THEN ' AND ' ELSE '' END || CASE WHEN v_n2 THEN format('%I = %L', 'id', v_s2) ELSE 'FALSE' END; END IF;
  IF v_s2 IS NOT NULL THEN v_values := v_values || jsonb_build_object('id', v_s2); END IF;
  IF v_where = '' THEN v_where := 'TRUE'; END IF;
  RETURN jsonb_build_object('where', v_where, 'values', v_values, 'mode', CASE WHEN v_values ? 'id' THEN 'single' ELSE 'list' END, 'at', v_at);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_scope__fo_asks(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_rest TEXT := substring(p_name FROM 9);
BEGIN
  IF v_rest = '' THEN
    RETURN jsonb_build_object('where', 'TRUE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL);
  END IF;
  RETURN jsonb_build_object('where', format('id = %L', v_rest), 'values', jsonb_build_object('id', v_rest::BIGINT), 'mode', 'single', 'at', NULL);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_scope__fo_asks_from(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_where  TEXT := '';
  v_values JSONB := '{}'::jsonb;
  v_at     TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 14), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN v_where := v_where || CASE WHEN v_where <> '' THEN ' AND ' ELSE '' END || format('%I = %L', 'from', v_s1); END IF;
  IF v_s1 IS NOT NULL THEN v_values := v_values || jsonb_build_object('from', v_s1); END IF;
  IF v_where = '' THEN v_where := 'TRUE'; END IF;
  RETURN jsonb_build_object('where', v_where, 'values', v_values, 'mode', CASE WHEN v_values ? 'id' THEN 'single' ELSE 'list' END, 'at', v_at);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_scope__fo_pub_courses(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_rest TEXT := substring(p_name FROM 16);
BEGIN
  IF v_rest = '' THEN
    RETURN jsonb_build_object('where', 'TRUE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL);
  END IF;
  RETURN jsonb_build_object('where', format('id = %L', v_rest), 'values', jsonb_build_object('id', v_rest::BIGINT), 'mode', 'single', 'at', NULL);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_resolve_scope(p_def _delta_docs, p_doc_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
BEGIN
  CASE p_def.prefix
    WHEN 'fo-board:' THEN RETURN dzql_scope__fo_board(p_doc_name, p_refuse);
    WHEN 'fo-menu:' THEN RETURN dzql_scope__fo_menu(p_doc_name, p_refuse);
    WHEN 'fo-household:' THEN RETURN dzql_scope__fo_household(p_doc_name, p_refuse);
    WHEN 'fo-course:' THEN RETURN dzql_scope__fo_course(p_doc_name, p_refuse);
    WHEN 'fo-title:' THEN RETURN dzql_scope__fo_title(p_doc_name, p_refuse);
    WHEN 'fo-tagged:' THEN RETURN dzql_scope__fo_tagged(p_doc_name, p_refuse);
    WHEN 'fo-notes:' THEN RETURN dzql_scope__fo_notes(p_doc_name, p_refuse);
    WHEN 'fo-all-courses:' THEN RETURN dzql_scope__fo_all_courses(p_doc_name, p_refuse);
    WHEN 'fo-catalog:' THEN RETURN dzql_scope__fo_catalog(p_doc_name, p_refuse);
    WHEN 'fo-courses-noted:' THEN RETURN dzql_scope__fo_courses_noted(p_doc_name, p_refuse);
    WHEN 'fo-courses-like:' THEN RETURN dzql_scope__fo_courses_like(p_doc_name, p_refuse);
    WHEN 'fo-menu-like:' THEN RETURN dzql_scope__fo_menu_like(p_doc_name, p_refuse);
    WHEN 'fo-tags-labelled:' THEN RETURN dzql_scope__fo_tags_labelled(p_doc_name, p_refuse);
    WHEN 'fo-seating:' THEN RETURN dzql_scope__fo_seating(p_doc_name, p_refuse);
    WHEN 'fo-seats-kept:' THEN RETURN dzql_scope__fo_seats_kept(p_doc_name, p_refuse);
    WHEN 'fo-seats-upto:' THEN RETURN dzql_scope__fo_seats_upto(p_doc_name, p_refuse);
    WHEN 'fo-seats-at:' THEN RETURN dzql_scope__fo_seats_at(p_doc_name, p_refuse);
    WHEN 'fo-seats-wished:' THEN RETURN dzql_scope__fo_seats_wished(p_doc_name, p_refuse);
    WHEN 'fo-slots-upto:' THEN RETURN dzql_scope__fo_slots_upto(p_doc_name, p_refuse);
    WHEN 'fo-slots-of:' THEN RETURN dzql_scope__fo_slots_of(p_doc_name, p_refuse);
    WHEN 'fo-slots-under:' THEN RETURN dzql_scope__fo_slots_under(p_doc_name, p_refuse);
    WHEN 'fo-slots-by:' THEN RETURN dzql_scope__fo_slots_by(p_doc_name, p_refuse);
    WHEN 'fo-slots-on:' THEN RETURN dzql_scope__fo_slots_on(p_doc_name, p_refuse);
    WHEN 'fo-note:' THEN RETURN dzql_scope__fo_note(p_doc_name, p_refuse);
    WHEN 'fo-all-notes:' THEN RETURN dzql_scope__fo_all_notes(p_doc_name, p_refuse);
    WHEN 'fo-drinks:' THEN RETURN dzql_scope__fo_drinks(p_doc_name, p_refuse);
    WHEN 'fo-course-guests:' THEN RETURN dzql_scope__fo_course_guests(p_doc_name, p_refuse);
    WHEN 'fo-plan:' THEN RETURN dzql_scope__fo_plan(p_doc_name, p_refuse);
    WHEN 'fo-weddings:' THEN RETURN dzql_scope__fo_weddings(p_doc_name, p_refuse);
    WHEN 'fo-guest:' THEN RETURN dzql_scope__fo_guest(p_doc_name, p_refuse);
    WHEN 'fo-seat-of:' THEN RETURN dzql_scope__fo_seat_of(p_doc_name, p_refuse);
    WHEN 'fo-all-households:' THEN RETURN dzql_scope__fo_all_households(p_doc_name, p_refuse);
    WHEN 'fo-party:' THEN RETURN dzql_scope__fo_party(p_doc_name, p_refuse);
    WHEN 'fo-slim:' THEN RETURN dzql_scope__fo_slim(p_doc_name, p_refuse);
    WHEN 'fo-notes-on:' THEN RETURN dzql_scope__fo_notes_on(p_doc_name, p_refuse);
    WHEN 'fo-courses-noted-on:' THEN RETURN dzql_scope__fo_courses_noted_on(p_doc_name, p_refuse);
    WHEN 'fo-board-on:' THEN RETURN dzql_scope__fo_board_on(p_doc_name, p_refuse);
    WHEN 'fo-asks:' THEN RETURN dzql_scope__fo_asks(p_doc_name, p_refuse);
    WHEN 'fo-asks-from:' THEN RETURN dzql_scope__fo_asks_from(p_doc_name, p_refuse);
    WHEN 'fo-pub-courses:' THEN RETURN dzql_scope__fo_pub_courses(p_doc_name, p_refuse);
    ELSE RAISE EXCEPTION 'no doc def for: %', p_doc_name USING ERRCODE = 'P0001';
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
`;
