CREATE OR REPLACE FUNCTION dzql_scope__fo_slots_upto(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_where  TEXT := '';
  v_values JSONB := '{}'::jsonb;
  v_at     TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN IF p_refuse THEN RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('price must be a number, not "%s"', v_s1)); END IF;
    BEGIN
      PERFORM v_s1::float8;
    EXCEPTION WHEN numeric_value_out_of_range THEN
      IF p_refuse THEN RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('price must be a number, not "%s"', v_s1));
    END;
  END IF;
  IF v_s1 IS NOT NULL THEN v_where := v_where || CASE WHEN v_where <> '' THEN ' AND ' ELSE '' END || format('%I <= %L', 'price', v_s1); END IF;
  IF v_where = '' THEN v_where := 'TRUE'; END IF;
  RETURN jsonb_build_object('where', v_where, 'values', v_values, 'mode', CASE WHEN v_values ? 'id' THEN 'single' ELSE 'list' END, 'at', v_at);
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_scope__fo_slots_of(p_name TEXT, p_refuse BOOLEAN)
RETURNS JSONB AS $$
DECLARE
  v_where  TEXT := '';
  v_values JSONB := '{}'::jsonb;
  v_at     TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN IF p_refuse THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('weddings_id %s is past 2^53 - 1, which no number holds exactly', v_s1));
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN IF p_refuse THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('weddings_id %s is past 2^53 - 1, which no number holds exactly', v_s1));
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      IF p_refuse THEN RAISE EXCEPTION 'weddings_id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
      RETURN jsonb_build_object('where', 'FALSE', 'values', '{}'::jsonb, 'mode', 'list', 'at', NULL, 'refused', format('weddings_id must be an id -- a whole number, or text -- not "%s"', v_s1));
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_where := v_where || CASE WHEN v_where <> '' THEN ' AND ' ELSE '' END || CASE WHEN v_n1 THEN format('%I = %L', 'weddings_id', v_s1) ELSE 'FALSE' END; END IF;
  IF v_s1 IS NOT NULL THEN v_values := v_values || jsonb_build_object('weddings_id', v_s1); END IF;
  IF v_where = '' THEN v_where := 'TRUE'; END IF;
  RETURN jsonb_build_object('where', v_where, 'values', v_values, 'mode', CASE WHEN v_values ? 'id' THEN 'single' ELSE 'list' END, 'at', v_at);
END;
$$ LANGUAGE plpgsql STABLE;

