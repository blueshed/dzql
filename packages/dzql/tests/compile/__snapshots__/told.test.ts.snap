// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the compiled text is the same for the same definitions, and pinned 1`] = `
"CREATE OR REPLACE FUNCTION dzql_told__fo_board(p_name TEXT, p_rows JSONB)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_t      JSONB;
  v_told   JSONB := '[]'::jsonb;
  v_was    BOOLEAN;
  v_is     BOOLEAN;
  v_root   BOOLEAN;
  v_path   TEXT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 10);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  FOR v_t IN SELECT jsonb_array_elements(p_rows) LOOP
    v_was := (v_t->'before') ? p_name;
    v_is  := (v_t->'holders') ? p_name;
    CONTINUE WHEN NOT v_was AND NOT v_is;
    CONTINUE WHEN v_was AND v_is AND (v_t ? 'carried');   -- carried along, and its either way: unchanged for it
    v_root := v_single AND (v_t->>'coll') = 'weddings';
    v_path := CASE WHEN v_root THEN _delta_build_path(v_t->>'coll') ELSE _delta_build_path(v_t->>'coll', v_t->>'id') END;
    IF v_was AND v_is THEN   -- stayed: what changed
      v_told := v_told || COALESCE((SELECT jsonb_agg(jsonb_build_object('op', 'replace', 'path', v_path || _delta_build_path(f), 'value', v) ORDER BY f COLLATE "C")
                                      FROM jsonb_each(v_t->'after') AS e(f, v) WHERE v IS DISTINCT FROM v_t->'was'->f), '[]'::jsonb);
    ELSIF v_is THEN
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', CASE WHEN v_root THEN 'replace' ELSE 'add' END, 'path', v_path, 'value', v_t->'after'));
    ELSIF v_root THEN   -- gone: null
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'replace', 'path', v_path, 'value', 'null'::jsonb));
    ELSE
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'remove', 'path', v_path));
    END IF;
  END LOOP;
  RETURN v_told;
END;
$$ LANGUAGE plpgsql STABLE;

