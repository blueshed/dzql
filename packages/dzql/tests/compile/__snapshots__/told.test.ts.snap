CREATE OR REPLACE FUNCTION dzql_told__fo_guest(p_name TEXT, p_rows JSONB)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_t      JSONB;
  v_told   JSONB := '[]'::jsonb;
  v_was    BOOLEAN;
  v_is     BOOLEAN;
  v_root   BOOLEAN;
  v_path   TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 10), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  FOR v_t IN SELECT jsonb_array_elements(p_rows) LOOP
    v_was := (v_t->'before') ? p_name;
    v_is  := (v_t->'holders') ? p_name;
    CONTINUE WHEN NOT v_was AND NOT v_is;
    CONTINUE WHEN v_was AND v_is AND (v_t ? 'carried');   -- carried along, and its either way: unchanged for it
    v_root := v_single AND (v_t->>'coll') = 'households';
    v_path := CASE WHEN v_root THEN _delta_build_path(v_t->>'coll') ELSE _delta_build_path(v_t->>'coll', v_t->>'id') END;
    IF v_was AND v_is THEN   -- stayed: what changed
      v_told := v_told || COALESCE((SELECT jsonb_agg(jsonb_build_object('op', 'replace', 'path', v_path || _delta_build_path(f), 'value', v) ORDER BY f COLLATE "C")
                                      FROM jsonb_each(v_t->'after') AS e(f, v) WHERE v IS DISTINCT FROM v_t->'was'->f), '[]'::jsonb);
    ELSIF v_is THEN
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', CASE WHEN v_root THEN 'replace' ELSE 'add' END, 'path', v_path, 'value', v_t->'after'));
    ELSIF v_root THEN   -- gone: null
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'replace', 'path', v_path, 'value', 'null'::jsonb));
    ELSE
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'remove', 'path', v_path));
    END IF;
  END LOOP;
  RETURN v_told;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_told__fo_seat_of(p_name TEXT, p_rows JSONB)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_t      JSONB;
  v_told   JSONB := '[]'::jsonb;
  v_was    BOOLEAN;
  v_is     BOOLEAN;
  v_root   BOOLEAN;
  v_path   TEXT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 12), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  IF v_s2 IS NOT NULL THEN
    IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    ELSIF abs(v_s2::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    END IF;
  END IF;
  FOR v_t IN SELECT jsonb_array_elements(p_rows) LOOP
    v_was := (v_t->'before') ? p_name;
    v_is  := (v_t->'holders') ? p_name;
    CONTINUE WHEN NOT v_was AND NOT v_is;
    CONTINUE WHEN v_was AND v_is AND (v_t ? 'carried');   -- carried along, and its either way: unchanged for it
    v_root := v_single AND (v_t->>'coll') = 'seats';
    v_path := CASE WHEN v_root THEN _delta_build_path(v_t->>'coll') ELSE _delta_build_path(v_t->>'coll', v_t->>'id') END;
    IF v_was AND v_is THEN   -- stayed: what changed
      v_told := v_told || COALESCE((SELECT jsonb_agg(jsonb_build_object('op', 'replace', 'path', v_path || _delta_build_path(f), 'value', v) ORDER BY f COLLATE "C")
                                      FROM jsonb_each(v_t->'after') AS e(f, v) WHERE v IS DISTINCT FROM v_t->'was'->f), '[]'::jsonb);
    ELSIF v_is THEN
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', CASE WHEN v_root THEN 'replace' ELSE 'add' END, 'path', v_path, 'value', v_t->'after'));
    ELSIF v_root THEN   -- gone: null
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'replace', 'path', v_path, 'value', 'null'::jsonb));
    ELSE
      v_told := v_told || jsonb_build_array(jsonb_build_object('op', 'remove', 'path', v_path));
    END IF;
  END LOOP;
  RETURN v_told;
END;
$$ LANGUAGE plpgsql STABLE;

