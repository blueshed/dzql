exports[`the compiled text is the same for the same definitions, and pinned 1`] = `
"CREATE OR REPLACE FUNCTION dzql_holds__fo_board(p_name TEXT, p_coll TEXT, p_row JSONB)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rest TEXT;
BEGIN
  IF p_row IS NULL OR p_coll NOT IN ('weddings', 'households', 'courses', 'drinks', 'tags', 'notes') THEN RETURN FALSE; END IF;
  v_rest := substring(p_name FROM 10);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  CASE p_coll
    WHEN 'weddings' THEN
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"fo_weddings", p_row) t WHERE TRUE);
    WHEN 'households' THEN
      IF NOT v_single THEN RETURN TRUE; END IF;
      RETURN (p_row->>'weddings_id')::BIGINT IS NOT DISTINCT FROM v_id;
    WHEN 'courses' THEN
      IF NOT v_single THEN RETURN TRUE; END IF;
      RETURN (p_row->>'weddings_id')::BIGINT IS NOT DISTINCT FROM v_id;
    WHEN 'drinks' THEN
      IF NOT v_single THEN RETURN TRUE; END IF;
      RETURN (SELECT p."weddings_id" FROM "fo_courses" p WHERE p.id = (p_row->>'courses_id')::BIGINT) IS NOT DISTINCT FROM v_id;
    WHEN 'tags' THEN
      RETURN TRUE;
    WHEN 'notes' THEN
      IF p_at <= now() THEN RETURN FALSE; END IF;
      IF NOT v_single THEN RETURN TRUE; END IF;
      RETURN (p_row->>'weddings_id')::BIGINT IS NOT DISTINCT FROM v_id;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

