CREATE OR REPLACE FUNCTION dzql_holds__fo_guest(p_name TEXT, p_coll TEXT, p_row JSONB)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  IF p_row IS NULL OR p_coll NOT IN ('households') THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 10), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RETURN FALSE;
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RETURN FALSE;
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RETURN FALSE;
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  CASE p_coll
    WHEN 'households' THEN
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"fo_households", p_row) t WHERE (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."email" = v_s2::TEXT));
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

