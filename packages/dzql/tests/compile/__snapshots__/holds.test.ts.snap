CREATE OR REPLACE FUNCTION dzql_holds__fo_seats_at(p_name TEXT, p_coll TEXT, p_row JSONB)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  IF p_row IS NULL OR p_coll NOT IN ('seats') THEN RETURN FALSE; END IF;
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RETURN FALSE;
    ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RETURN FALSE;
    END IF;
  END IF;
  CASE p_coll
    WHEN 'seats' THEN
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"fo_seats", p_row) t WHERE (v_s1 IS NULL OR t."table_no" = v_s1::BIGINT));
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

