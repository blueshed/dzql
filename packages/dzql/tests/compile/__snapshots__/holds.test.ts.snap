      v_n1 := FALSE;
    END IF;
  END IF;
  IF v_s1 IS NOT NULL THEN v_single := TRUE; v_id := v_s1::BIGINT; END IF;
  v_s2 := NULLIF(v_parts[2], '');
  IF v_s2 IS NOT NULL THEN
    IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RETURN FALSE;
    ELSIF abs(v_s2::numeric) > 9007199254740991 THEN RETURN FALSE;
    END IF;
  END IF;
  CASE p_coll
    WHEN 'seats' THEN
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"fo_seats", p_row) t WHERE (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."table_no" = v_s2::BIGINT));
  END CASE;
