  v_s1 := NULLIF(v_parts[1], '');
  CASE p_coll
    WHEN 'asks' THEN
      IF p_at <= now() THEN RETURN FALSE; END IF;
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"order", p_row) t WHERE (v_s1 IS NULL OR t."from" = v_s1::TEXT));
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_holds__fo_pub_courses(p_name TEXT, p_coll TEXT, p_row JSONB)
RETURNS BOOLEAN AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rest TEXT;
BEGIN
  IF p_row IS NULL OR p_coll NOT IN ('courses') THEN RETURN FALSE; END IF;
  v_rest := substring(p_name FROM 16);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  CASE p_coll
    WHEN 'courses' THEN
      IF v_single AND (p_row->>'id')::BIGINT IS DISTINCT FROM v_id THEN RETURN FALSE; END IF;
      RETURN EXISTS (SELECT 1 FROM jsonb_populate_record(null::"fo_courses", p_row) t WHERE TRUE);
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_doc_holds(p_def _delta_docs, p_doc_name TEXT, p_coll TEXT, p_row JSONB)
RETURNS BOOLEAN AS $$
BEGIN
  CASE p_def.prefix
    WHEN 'fo-board:' THEN RETURN dzql_holds__fo_board(p_doc_name, p_coll, p_row);
    WHEN 'fo-menu:' THEN RETURN dzql_holds__fo_menu(p_doc_name, p_coll, p_row);
    WHEN 'fo-household:' THEN RETURN dzql_holds__fo_household(p_doc_name, p_coll, p_row);
    WHEN 'fo-course:' THEN RETURN dzql_holds__fo_course(p_doc_name, p_coll, p_row);
    WHEN 'fo-title:' THEN RETURN dzql_holds__fo_title(p_doc_name, p_coll, p_row);
    WHEN 'fo-tagged:' THEN RETURN dzql_holds__fo_tagged(p_doc_name, p_coll, p_row);
    WHEN 'fo-notes:' THEN RETURN dzql_holds__fo_notes(p_doc_name, p_coll, p_row);
    WHEN 'fo-all-courses:' THEN RETURN dzql_holds__fo_all_courses(p_doc_name, p_coll, p_row);
    WHEN 'fo-catalog:' THEN RETURN dzql_holds__fo_catalog(p_doc_name, p_coll, p_row);
    WHEN 'fo-courses-noted:' THEN RETURN dzql_holds__fo_courses_noted(p_doc_name, p_coll, p_row);
    WHEN 'fo-courses-like:' THEN RETURN dzql_holds__fo_courses_like(p_doc_name, p_coll, p_row);
    WHEN 'fo-menu-like:' THEN RETURN dzql_holds__fo_menu_like(p_doc_name, p_coll, p_row);
    WHEN 'fo-tags-labelled:' THEN RETURN dzql_holds__fo_tags_labelled(p_doc_name, p_coll, p_row);
    WHEN 'fo-seating:' THEN RETURN dzql_holds__fo_seating(p_doc_name, p_coll, p_row);
    WHEN 'fo-seats-kept:' THEN RETURN dzql_holds__fo_seats_kept(p_doc_name, p_coll, p_row);
    WHEN 'fo-seats-upto:' THEN RETURN dzql_holds__fo_seats_upto(p_doc_name, p_coll, p_row);
    WHEN 'fo-seats-at:' THEN RETURN dzql_holds__fo_seats_at(p_doc_name, p_coll, p_row);
    WHEN 'fo-seats-wished:' THEN RETURN dzql_holds__fo_seats_wished(p_doc_name, p_coll, p_row);
    WHEN 'fo-slots-upto:' THEN RETURN dzql_holds__fo_slots_upto(p_doc_name, p_coll, p_row);
    WHEN 'fo-slots-of:' THEN RETURN dzql_holds__fo_slots_of(p_doc_name, p_coll, p_row);
    WHEN 'fo-slots-under:' THEN RETURN dzql_holds__fo_slots_under(p_doc_name, p_coll, p_row);
    WHEN 'fo-slots-by:' THEN RETURN dzql_holds__fo_slots_by(p_doc_name, p_coll, p_row);
    WHEN 'fo-slots-on:' THEN RETURN dzql_holds__fo_slots_on(p_doc_name, p_coll, p_row);
    WHEN 'fo-note:' THEN RETURN dzql_holds__fo_note(p_doc_name, p_coll, p_row);
    WHEN 'fo-all-notes:' THEN RETURN dzql_holds__fo_all_notes(p_doc_name, p_coll, p_row);
    WHEN 'fo-drinks:' THEN RETURN dzql_holds__fo_drinks(p_doc_name, p_coll, p_row);
    WHEN 'fo-course-guests:' THEN RETURN dzql_holds__fo_course_guests(p_doc_name, p_coll, p_row);
    WHEN 'fo-plan:' THEN RETURN dzql_holds__fo_plan(p_doc_name, p_coll, p_row);
    WHEN 'fo-weddings:' THEN RETURN dzql_holds__fo_weddings(p_doc_name, p_coll, p_row);
    WHEN 'fo-guest:' THEN RETURN dzql_holds__fo_guest(p_doc_name, p_coll, p_row);
    WHEN 'fo-seat-of:' THEN RETURN dzql_holds__fo_seat_of(p_doc_name, p_coll, p_row);
    WHEN 'fo-all-households:' THEN RETURN dzql_holds__fo_all_households(p_doc_name, p_coll, p_row);
    WHEN 'fo-party:' THEN RETURN dzql_holds__fo_party(p_doc_name, p_coll, p_row);
    WHEN 'fo-slim:' THEN RETURN dzql_holds__fo_slim(p_doc_name, p_coll, p_row);
    WHEN 'fo-notes-on:' THEN RETURN dzql_holds__fo_notes_on(p_doc_name, p_coll, p_row);
    WHEN 'fo-courses-noted-on:' THEN RETURN dzql_holds__fo_courses_noted_on(p_doc_name, p_coll, p_row);
    WHEN 'fo-board-on:' THEN RETURN dzql_holds__fo_board_on(p_doc_name, p_coll, p_row);
    WHEN 'fo-asks:' THEN RETURN dzql_holds__fo_asks(p_doc_name, p_coll, p_row);
    WHEN 'fo-asks-from:' THEN RETURN dzql_holds__fo_asks_from(p_doc_name, p_coll, p_row);
    WHEN 'fo-pub-courses:' THEN RETURN dzql_holds__fo_pub_courses(p_doc_name, p_coll, p_row);
    ELSE RETURN _delta_doc_holds_framework(p_def, p_doc_name, p_coll, p_row);
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
`;
