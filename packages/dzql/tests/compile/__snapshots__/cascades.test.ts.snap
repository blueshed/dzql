"CREATE OR REPLACE FUNCTION dzql_cascade_remove__weddings(p_id BIGINT)
RETURNS JSONB AS $$
DECLARE
  v_affected BIGINT;
  v_id       BIGINT;
  v_ops      JSONB;
BEGIN
  DELETE FROM "fo_weddings" WHERE id = p_id;
  GET DIAGNOSTICS v_affected = ROW_COUNT;
  IF v_affected = 0 THEN RETURN '[]'::jsonb; END IF;   -- only a removal that happened (closed already, or RLS filtered it)
  v_ops := jsonb_build_array(jsonb_build_object('op', 'remove', 'path', _delta_build_path('weddings', p_id::text)));
  FOR v_id IN SELECT id FROM "current_order" WHERE "group" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__asks(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_courses" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__courses(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_favours" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__favours(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_households" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__households(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "current_fo_notes" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__notes(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_seats" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__seats(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_slots" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_ops := v_ops || dzql_cascade_remove__slots(v_id);
  END LOOP;
  RETURN v_ops;
END;
$$ LANGUAGE plpgsql;

