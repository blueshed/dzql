    v_rows := v_rows || dzql_cascade_rows__notes(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_seats" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_rows := v_rows || dzql_cascade_rows__seats(v_id);
  END LOOP;
  FOR v_id IN SELECT id FROM "fo_slots" WHERE "weddings_id" = p_id ORDER BY id LOOP
    v_rows := v_rows || dzql_cascade_rows__slots(v_id);
  END LOOP;
