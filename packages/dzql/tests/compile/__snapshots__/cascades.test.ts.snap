RETURNS JSONB AS $$
DECLARE
  v_row  JSONB;
  v_id   BIGINT;
  v_rows JSONB;
BEGIN
  SELECT to_jsonb(t.*) INTO v_row FROM "fo_weddings" t WHERE t.id = p_id;
  IF v_row IS NULL THEN RETURN '[]'::jsonb; END IF;
  v_rows := jsonb_build_array(jsonb_build_object('coll', 'weddings', 'id', p_id, 'row', _delta_strip_temporal(v_row)));
