CREATE OR REPLACE FUNCTION _delta_cascade_remove(p_collection_key TEXT, p_id BIGINT)
RETURNS JSONB AS $$
BEGIN
  CASE p_collection_key
    WHEN 'weddings' THEN RETURN dzql_cascade_remove__weddings(p_id);
    WHEN 'households' THEN RETURN dzql_cascade_remove__households(p_id);
    WHEN 'courses' THEN RETURN dzql_cascade_remove__courses(p_id);
    WHEN 'drinks' THEN RETURN dzql_cascade_remove__drinks(p_id);
    WHEN 'tags' THEN RETURN dzql_cascade_remove__tags(p_id);
    WHEN 'notes' THEN RETURN dzql_cascade_remove__notes(p_id);
    WHEN 'seats' THEN RETURN dzql_cascade_remove__seats(p_id);
    WHEN 'slots' THEN RETURN dzql_cascade_remove__slots(p_id);
    WHEN 'favours' THEN RETURN dzql_cascade_remove__favours(p_id);
    WHEN 'asks' THEN RETURN dzql_cascade_remove__asks(p_id);
    ELSE RETURN '[]'::jsonb;   -- a collection there is not: nothing to take, nothing hangs from it
  END CASE;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION _delta_cascade_rows(p_collection_key TEXT, p_id BIGINT)
RETURNS JSONB AS $$
BEGIN
  CASE p_collection_key
    WHEN 'weddings' THEN RETURN dzql_cascade_rows__weddings(p_id);
    WHEN 'households' THEN RETURN dzql_cascade_rows__households(p_id);
    WHEN 'courses' THEN RETURN dzql_cascade_rows__courses(p_id);
    WHEN 'drinks' THEN RETURN dzql_cascade_rows__drinks(p_id);
    WHEN 'tags' THEN RETURN dzql_cascade_rows__tags(p_id);
    WHEN 'notes' THEN RETURN dzql_cascade_rows__notes(p_id);
    WHEN 'seats' THEN RETURN dzql_cascade_rows__seats(p_id);
    WHEN 'slots' THEN RETURN dzql_cascade_rows__slots(p_id);
    WHEN 'favours' THEN RETURN dzql_cascade_rows__favours(p_id);
    WHEN 'asks' THEN RETURN dzql_cascade_rows__asks(p_id);
    ELSE RETURN '[]'::jsonb;   -- a collection there is not: nothing to take, nothing hangs from it
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_hanging_rows(p_collection_key TEXT, p_id BIGINT)
RETURNS JSONB AS $$
BEGIN
  CASE p_collection_key
    WHEN 'weddings' THEN RETURN dzql_hanging_rows__weddings(p_id);
    WHEN 'households' THEN RETURN dzql_hanging_rows__households(p_id);
    WHEN 'courses' THEN RETURN dzql_hanging_rows__courses(p_id);
    WHEN 'drinks' THEN RETURN dzql_hanging_rows__drinks(p_id);
    WHEN 'tags' THEN RETURN dzql_hanging_rows__tags(p_id);
    WHEN 'notes' THEN RETURN dzql_hanging_rows__notes(p_id);
    WHEN 'seats' THEN RETURN dzql_hanging_rows__seats(p_id);
    WHEN 'slots' THEN RETURN dzql_hanging_rows__slots(p_id);
    WHEN 'favours' THEN RETURN dzql_hanging_rows__favours(p_id);
    WHEN 'asks' THEN RETURN dzql_hanging_rows__asks(p_id);
    ELSE RETURN '[]'::jsonb;   -- a collection there is not: nothing to take, nothing hangs from it
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
`;
