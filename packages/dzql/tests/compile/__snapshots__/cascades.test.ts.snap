CREATE OR REPLACE FUNCTION dzql_hanging_rows__weddings(p_id BIGINT)
RETURNS JSONB AS $$
DECLARE
  v_part JSONB;
  v_rows JSONB := '[]'::jsonb;
BEGIN
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "current_order" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'asks', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."group" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "fo_courses" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'courses', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || dzql_hanging_rows__courses(t.id))
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "fo_favours" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'favours', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "fo_households" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'households', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "current_fo_notes" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'notes', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "fo_seats" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'seats', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  SELECT COALESCE(jsonb_agg(e ORDER BY t.id, n), '[]'::jsonb) INTO v_part FROM "fo_slots" t,
         jsonb_array_elements(jsonb_build_array(jsonb_build_object('coll', 'slots', 'id', t.id, 'row', _delta_strip_temporal(to_jsonb(t.*)))) || '[]'::jsonb)
           WITH ORDINALITY AS x(e, n)
   WHERE t."weddings_id" = p_id;
  v_rows := v_rows || v_part;
  RETURN v_rows;
END;
$$ LANGUAGE plpgsql STABLE;

