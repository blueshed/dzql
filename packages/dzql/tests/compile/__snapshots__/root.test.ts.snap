CREATE OR REPLACE FUNCTION dzql_root_there__fo_seats_kept(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    BEGIN
      PERFORM v_s1::BOOLEAN;
    EXCEPTION WHEN invalid_text_representation THEN
      RAISE EXCEPTION 'kept must be a boolean (true/false, yes/no, on/off, 1/0, or a prefix), not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_seats" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."kept" = v_s1::BOOLEAN));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_seats_upto(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    BEGIN
      PERFORM v_s1::BOOLEAN;
    EXCEPTION WHEN invalid_text_representation THEN
      RAISE EXCEPTION 'kept must be a boolean (true/false, yes/no, on/off, 1/0, or a prefix), not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_seats" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."kept" <= v_s1::BOOLEAN));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_seats_at(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_seats" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."table_no" = v_s1::BIGINT));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_seats_wished(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 17), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    BEGIN
      PERFORM v_s1::JSONB;
    EXCEPTION WHEN invalid_text_representation THEN
      RAISE EXCEPTION 'wishes must be JSON, not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_seats" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."wishes" = v_s1::JSONB));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_slots_upto(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
    BEGIN
      PERFORM v_s1::float8;
    EXCEPTION WHEN numeric_value_out_of_range THEN
      RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = p_id AND (v_s1 IS NULL OR t."price" <= v_s1::DOUBLE PRECISION));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_slots_of(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'weddings_id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_slots" t WHERE t.id = p_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."weddings_id" = v_s1::BIGINT ELSE FALSE END)));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_slots_under(p_name TEXT, p_id BIGINT)
