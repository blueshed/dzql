CREATE OR REPLACE FUNCTION _delta_root_there(p_def _delta_docs, p_doc_name TEXT, p_scope JSONB, p_view TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
BEGIN
  CASE p_def.prefix
    WHEN 'fo-board:' THEN RETURN dzql_root_there__fo_board(p_doc_name, p_id);
    WHEN 'fo-menu:' THEN RETURN dzql_root_there__fo_menu(p_doc_name, p_id);
    WHEN 'fo-household:' THEN RETURN dzql_root_there__fo_household(p_doc_name, p_id);
    WHEN 'fo-course:' THEN RETURN dzql_root_there__fo_course(p_doc_name, p_id);
    WHEN 'fo-title:' THEN RETURN dzql_root_there__fo_title(p_doc_name, p_id);
    WHEN 'fo-tagged:' THEN RETURN dzql_root_there__fo_tagged(p_doc_name, p_id);
    WHEN 'fo-notes:' THEN RETURN dzql_root_there__fo_notes(p_doc_name, p_id);
    WHEN 'fo-all-courses:' THEN RETURN dzql_root_there__fo_all_courses(p_doc_name, p_id);
    WHEN 'fo-catalog:' THEN RETURN dzql_root_there__fo_catalog(p_doc_name, p_id);
    WHEN 'fo-courses-noted:' THEN RETURN dzql_root_there__fo_courses_noted(p_doc_name, p_id);
    WHEN 'fo-courses-like:' THEN RETURN dzql_root_there__fo_courses_like(p_doc_name, p_id);
    WHEN 'fo-menu-like:' THEN RETURN dzql_root_there__fo_menu_like(p_doc_name, p_id);
    WHEN 'fo-tags-labelled:' THEN RETURN dzql_root_there__fo_tags_labelled(p_doc_name, p_id);
    WHEN 'fo-seating:' THEN RETURN dzql_root_there__fo_seating(p_doc_name, p_id);
    WHEN 'fo-seats-kept:' THEN RETURN dzql_root_there__fo_seats_kept(p_doc_name, p_id);
    WHEN 'fo-seats-upto:' THEN RETURN dzql_root_there__fo_seats_upto(p_doc_name, p_id);
    WHEN 'fo-seats-at:' THEN RETURN dzql_root_there__fo_seats_at(p_doc_name, p_id);
    WHEN 'fo-seats-wished:' THEN RETURN dzql_root_there__fo_seats_wished(p_doc_name, p_id);
    WHEN 'fo-slots-upto:' THEN RETURN dzql_root_there__fo_slots_upto(p_doc_name, p_id);
    WHEN 'fo-slots-of:' THEN RETURN dzql_root_there__fo_slots_of(p_doc_name, p_id);
    WHEN 'fo-slots-under:' THEN RETURN dzql_root_there__fo_slots_under(p_doc_name, p_id);
    WHEN 'fo-slots-by:' THEN RETURN dzql_root_there__fo_slots_by(p_doc_name, p_id);
    WHEN 'fo-slots-on:' THEN RETURN dzql_root_there__fo_slots_on(p_doc_name, p_id);
    WHEN 'fo-note:' THEN RETURN dzql_root_there__fo_note(p_doc_name, p_id);
    WHEN 'fo-all-notes:' THEN RETURN dzql_root_there__fo_all_notes(p_doc_name, p_id);
    WHEN 'fo-drinks:' THEN RETURN dzql_root_there__fo_drinks(p_doc_name, p_id);
    WHEN 'fo-course-guests:' THEN RETURN dzql_root_there__fo_course_guests(p_doc_name, p_id);
    WHEN 'fo-plan:' THEN RETURN dzql_root_there__fo_plan(p_doc_name, p_id);
    WHEN 'fo-weddings:' THEN RETURN dzql_root_there__fo_weddings(p_doc_name, p_id);
    WHEN 'fo-guest:' THEN RETURN dzql_root_there__fo_guest(p_doc_name, p_id);
    WHEN 'fo-seat-of:' THEN RETURN dzql_root_there__fo_seat_of(p_doc_name, p_id);
    WHEN 'fo-all-households:' THEN RETURN dzql_root_there__fo_all_households(p_doc_name, p_id);
    WHEN 'fo-party:' THEN RETURN dzql_root_there__fo_party(p_doc_name, p_id);
    WHEN 'fo-slim:' THEN RETURN dzql_root_there__fo_slim(p_doc_name, p_id);
    WHEN 'fo-notes-on:' THEN RETURN dzql_root_there__fo_notes_on(p_doc_name, p_id);
    WHEN 'fo-courses-noted-on:' THEN RETURN dzql_root_there__fo_courses_noted_on(p_doc_name, p_id);
    WHEN 'fo-board-on:' THEN RETURN dzql_root_there__fo_board_on(p_doc_name, p_id);
    WHEN 'fo-asks:' THEN RETURN dzql_root_there__fo_asks(p_doc_name, p_id);
    WHEN 'fo-asks-from:' THEN RETURN dzql_root_there__fo_asks_from(p_doc_name, p_id);
    WHEN 'fo-pub-courses:' THEN RETURN dzql_root_there__fo_pub_courses(p_doc_name, p_id);
    ELSE RAISE EXCEPTION 'no doc def for: %', p_doc_name USING ERRCODE = 'P0001';
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

"
`;
