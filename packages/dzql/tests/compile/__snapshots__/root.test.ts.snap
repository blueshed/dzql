CREATE OR REPLACE FUNCTION dzql_root_there__fo_guest(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 10), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  v_s2 := NULLIF(v_parts[2], '');
  RETURN EXISTS (SELECT 1 FROM "fo_households" t WHERE t.id = p_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."email" = v_s2::TEXT));
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION dzql_root_there__fo_seat_of(p_name TEXT, p_id BIGINT)
RETURNS BOOLEAN AS $$
DECLARE
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
  v_s2 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 12), ':');
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  v_s2 := NULLIF(v_parts[2], '');
  IF v_s2 IS NOT NULL THEN
    IF v_s2 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    ELSIF abs(v_s2::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s2 USING ERRCODE = '22P02';
    END IF;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_seats" t WHERE t.id = p_id AND (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."id" = v_s1::BIGINT ELSE FALSE END)) AND (v_s2 IS NULL OR t."table_no" = v_s2::BIGINT));
END;
$$ LANGUAGE plpgsql STABLE;

