    ELSIF v_s2 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'id must be an id -- a whole number, or text -- not "%"', v_s2 USING ERRCODE = '22P02';
    ELSE
      v_n2 := FALSE;
    END IF;
  END IF;
  RETURN EXISTS (SELECT 1 FROM "fo_weddings" t WHERE t.id = p_id AND (v_s2 IS NULL OR (CASE WHEN v_n2 THEN t."id" = v_s2::BIGINT ELSE FALSE END)));
END;
$$ LANGUAGE plpgsql STABLE;

