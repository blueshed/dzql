CREATE OR REPLACE FUNCTION dzql_columns__fo_slim(p_coll TEXT, p_columns_def JSONB)
RETURNS JSONB AS $$
DECLARE
  v_cols JSONB;
BEGIN
  v_cols := COALESCE(NULLIF(current_setting('delta.declared', true), '')::jsonb -> p_coll, p_columns_def);
  CASE p_coll
    WHEN 'households' THEN RETURN COALESCE((SELECT jsonb_object_agg(k, v) FROM jsonb_each(v_cols) AS e(k, v) WHERE k IN ('email')), '{}'::jsonb);
    WHEN 'seats' THEN RETURN COALESCE((SELECT jsonb_object_agg(k, v) FROM jsonb_each(v_cols) AS e(k, v) WHERE k IN ('table_no')), '{}'::jsonb);
    ELSE RETURN v_cols;
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

