CREATE OR REPLACE FUNCTION _delta_write_columns(p_def _delta_docs, p_coll TEXT, p_columns_def JSONB)
RETURNS JSONB AS $$
BEGIN
  CASE p_def.prefix
    WHEN 'fo-board:' THEN RETURN dzql_columns__fo_board(p_coll, p_columns_def);
    WHEN 'fo-menu:' THEN RETURN dzql_columns__fo_menu(p_coll, p_columns_def);
    WHEN 'fo-household:' THEN RETURN dzql_columns__fo_household(p_coll, p_columns_def);
    WHEN 'fo-course:' THEN RETURN dzql_columns__fo_course(p_coll, p_columns_def);
    WHEN 'fo-title:' THEN RETURN dzql_columns__fo_title(p_coll, p_columns_def);
    WHEN 'fo-tagged:' THEN RETURN dzql_columns__fo_tagged(p_coll, p_columns_def);
    WHEN 'fo-notes:' THEN RETURN dzql_columns__fo_notes(p_coll, p_columns_def);
    WHEN 'fo-all-courses:' THEN RETURN dzql_columns__fo_all_courses(p_coll, p_columns_def);
    WHEN 'fo-catalog:' THEN RETURN dzql_columns__fo_catalog(p_coll, p_columns_def);
    WHEN 'fo-courses-noted:' THEN RETURN dzql_columns__fo_courses_noted(p_coll, p_columns_def);
    WHEN 'fo-courses-like:' THEN RETURN dzql_columns__fo_courses_like(p_coll, p_columns_def);
    WHEN 'fo-menu-like:' THEN RETURN dzql_columns__fo_menu_like(p_coll, p_columns_def);
    WHEN 'fo-tags-labelled:' THEN RETURN dzql_columns__fo_tags_labelled(p_coll, p_columns_def);
    WHEN 'fo-seating:' THEN RETURN dzql_columns__fo_seating(p_coll, p_columns_def);
    WHEN 'fo-seats-kept:' THEN RETURN dzql_columns__fo_seats_kept(p_coll, p_columns_def);
    WHEN 'fo-seats-upto:' THEN RETURN dzql_columns__fo_seats_upto(p_coll, p_columns_def);
    WHEN 'fo-seats-at:' THEN RETURN dzql_columns__fo_seats_at(p_coll, p_columns_def);
    WHEN 'fo-seats-wished:' THEN RETURN dzql_columns__fo_seats_wished(p_coll, p_columns_def);
    WHEN 'fo-slots-upto:' THEN RETURN dzql_columns__fo_slots_upto(p_coll, p_columns_def);
    WHEN 'fo-slots-of:' THEN RETURN dzql_columns__fo_slots_of(p_coll, p_columns_def);
    WHEN 'fo-slots-under:' THEN RETURN dzql_columns__fo_slots_under(p_coll, p_columns_def);
    WHEN 'fo-slots-by:' THEN RETURN dzql_columns__fo_slots_by(p_coll, p_columns_def);
    WHEN 'fo-slots-on:' THEN RETURN dzql_columns__fo_slots_on(p_coll, p_columns_def);
    WHEN 'fo-note:' THEN RETURN dzql_columns__fo_note(p_coll, p_columns_def);
    WHEN 'fo-all-notes:' THEN RETURN dzql_columns__fo_all_notes(p_coll, p_columns_def);
    WHEN 'fo-drinks:' THEN RETURN dzql_columns__fo_drinks(p_coll, p_columns_def);
    WHEN 'fo-course-guests:' THEN RETURN dzql_columns__fo_course_guests(p_coll, p_columns_def);
    WHEN 'fo-plan:' THEN RETURN dzql_columns__fo_plan(p_coll, p_columns_def);
    WHEN 'fo-weddings:' THEN RETURN dzql_columns__fo_weddings(p_coll, p_columns_def);
    WHEN 'fo-guest:' THEN RETURN dzql_columns__fo_guest(p_coll, p_columns_def);
    WHEN 'fo-seat-of:' THEN RETURN dzql_columns__fo_seat_of(p_coll, p_columns_def);
    WHEN 'fo-all-households:' THEN RETURN dzql_columns__fo_all_households(p_coll, p_columns_def);
    WHEN 'fo-party:' THEN RETURN dzql_columns__fo_party(p_coll, p_columns_def);
    WHEN 'fo-slim:' THEN RETURN dzql_columns__fo_slim(p_coll, p_columns_def);
    WHEN 'fo-notes-on:' THEN RETURN dzql_columns__fo_notes_on(p_coll, p_columns_def);
    WHEN 'fo-courses-noted-on:' THEN RETURN dzql_columns__fo_courses_noted_on(p_coll, p_columns_def);
    WHEN 'fo-board-on:' THEN RETURN dzql_columns__fo_board_on(p_coll, p_columns_def);
    WHEN 'fo-asks:' THEN RETURN dzql_columns__fo_asks(p_coll, p_columns_def);
    WHEN 'fo-asks-from:' THEN RETURN dzql_columns__fo_asks_from(p_coll, p_columns_def);
    WHEN 'fo-pub-courses:' THEN RETURN dzql_columns__fo_pub_courses(p_coll, p_columns_def);
    ELSE RAISE EXCEPTION 'no doc def for: %', p_def.prefix USING ERRCODE = 'P0001';
  END CASE;
END;
$$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION _delta_assert_fields(p_collection TEXT, p_columns JSONB, p_parent_fk TEXT, p_value JSONB, p_path TEXT, p_add BOOLEAN, p_field BOOLEAN, p_missing TEXT)
RETURNS void AS $$
DECLARE
  v_bad TEXT;
  v_types TEXT;
BEGIN
  CASE p_collection
    WHEN 'weddings' THEN
      IF p_parent_fk IS NOT DISTINCT FROM NULL THEN
        IF p_columns = '{"name":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'name');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('name', CASE WHEN jsonb_typeof((p_value->'name')) = 'null' THEN 'name cannot be null' WHEN jsonb_typeof((p_value->'name')) <> 'null' AND NOT (jsonb_typeof((p_value->'name')) = 'string') THEN 'name must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'households' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"email":{"type":"text","nullable":false},"t":{"type":"text","nullable":true}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'email', 't');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('email', CASE WHEN jsonb_typeof((p_value->'email')) = 'null' THEN 'email cannot be null' WHEN jsonb_typeof((p_value->'email')) <> 'null' AND NOT (jsonb_typeof((p_value->'email')) = 'string') THEN 'email must be a string' END),
          ('t', CASE WHEN jsonb_typeof((p_value->'t')) <> 'null' AND NOT (jsonb_typeof((p_value->'t')) = 'string') THEN 't must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
        IF p_columns = '{"email":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'email');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('email', CASE WHEN jsonb_typeof((p_value->'email')) = 'null' THEN 'email cannot be null' WHEN jsonb_typeof((p_value->'email')) <> 'null' AND NOT (jsonb_typeof((p_value->'email')) = 'string') THEN 'email must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'courses' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"name":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'name');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('name', CASE WHEN jsonb_typeof((p_value->'name')) = 'null' THEN 'name cannot be null' WHEN jsonb_typeof((p_value->'name')) <> 'null' AND NOT (jsonb_typeof((p_value->'name')) = 'string') THEN 'name must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'drinks' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'courses_id' THEN
        IF p_columns = '{"name":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'courses_id', 'name');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('courses_id', CASE WHEN jsonb_typeof((p_value->'courses_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'courses_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'courses_id')) = 'string' OR (jsonb_typeof((p_value->'courses_id')) = 'number' AND (p_value->'courses_id')::text::numeric = trunc((p_value->'courses_id')::text::numeric))) THEN 'courses_id must be an id: an integer, or text' END),
          ('name', CASE WHEN jsonb_typeof((p_value->'name')) = 'null' THEN 'name cannot be null' WHEN jsonb_typeof((p_value->'name')) <> 'null' AND NOT (jsonb_typeof((p_value->'name')) = 'string') THEN 'name must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'tags' THEN
      IF p_parent_fk IS NOT DISTINCT FROM NULL THEN
        IF p_columns = '{"label":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'label');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('label', CASE WHEN jsonb_typeof((p_value->'label')) = 'null' THEN 'label cannot be null' WHEN jsonb_typeof((p_value->'label')) <> 'null' AND NOT (jsonb_typeof((p_value->'label')) = 'string') THEN 'label must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'notes' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"text":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'text');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('text', CASE WHEN jsonb_typeof((p_value->'text')) = 'null' THEN 'text cannot be null' WHEN jsonb_typeof((p_value->'text')) <> 'null' AND NOT (jsonb_typeof((p_value->'text')) = 'string') THEN 'text must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'seats' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"table_no":{"type":"integer","nullable":false},"kept":{"type":"boolean","nullable":false},"wishes":{"type":"json","nullable":true}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'table_no', 'kept', 'wishes');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('table_no', CASE WHEN jsonb_typeof((p_value->'table_no')) = 'null' THEN 'table_no cannot be null' WHEN jsonb_typeof((p_value->'table_no')) <> 'null' AND NOT (jsonb_typeof((p_value->'table_no')) = 'number' AND (p_value->'table_no')::text::numeric = trunc((p_value->'table_no')::text::numeric)) THEN 'table_no must be an integer' END),
          ('kept', CASE WHEN jsonb_typeof((p_value->'kept')) = 'null' THEN 'kept cannot be null' WHEN jsonb_typeof((p_value->'kept')) <> 'null' AND NOT (jsonb_typeof((p_value->'kept')) = 'boolean') THEN 'kept must be a boolean' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
        IF p_columns = '{"table_no":{"type":"integer","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'table_no');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('table_no', CASE WHEN jsonb_typeof((p_value->'table_no')) = 'null' THEN 'table_no cannot be null' WHEN jsonb_typeof((p_value->'table_no')) <> 'null' AND NOT (jsonb_typeof((p_value->'table_no')) = 'number' AND (p_value->'table_no')::text::numeric = trunc((p_value->'table_no')::text::numeric)) THEN 'table_no must be an integer' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'slots' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"price":{"type":"real","nullable":true},"starts":{"type":"timestamptz","nullable":true}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'price', 'starts');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('price', CASE WHEN jsonb_typeof((p_value->'price')) <> 'null' AND NOT (jsonb_typeof((p_value->'price')) = 'number') THEN 'price must be a number' END),
          ('starts', CASE WHEN jsonb_typeof((p_value->'starts')) <> 'null' AND NOT (jsonb_typeof((p_value->'starts')) = 'string' AND ((p_value->'starts') #>> '{}') ~ '^\\d{4}-\\d{2}-\\d{2}([T ]([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,6})?)?(Z|[+-]([01]\\d|2[0-3])(:?[0-5]\\d)?)?)?$' AND _delta_on_calendar((p_value->'starts') #>> '{}')) THEN 'starts must be an ISO-8601 time' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'favours' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'weddings_id' THEN
        IF p_columns = '{"households_id":{"type":"integer","nullable":false},"gift":{"type":"text","nullable":false}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'weddings_id', 'households_id', 'gift');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('weddings_id', CASE WHEN jsonb_typeof((p_value->'weddings_id')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'weddings_id cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'weddings_id')) = 'string' OR (jsonb_typeof((p_value->'weddings_id')) = 'number' AND (p_value->'weddings_id')::text::numeric = trunc((p_value->'weddings_id')::text::numeric))) THEN 'weddings_id must be an id: an integer, or text' END),
          ('households_id', CASE WHEN jsonb_typeof((p_value->'households_id')) = 'null' THEN 'households_id cannot be null' WHEN jsonb_typeof((p_value->'households_id')) <> 'null' AND NOT (jsonb_typeof((p_value->'households_id')) = 'number' AND (p_value->'households_id')::text::numeric = trunc((p_value->'households_id')::text::numeric)) THEN 'households_id must be an integer' END),
          ('gift', CASE WHEN jsonb_typeof((p_value->'gift')) = 'null' THEN 'gift cannot be null' WHEN jsonb_typeof((p_value->'gift')) <> 'null' AND NOT (jsonb_typeof((p_value->'gift')) = 'string') THEN 'gift must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    WHEN 'asks' THEN
      IF p_parent_fk IS NOT DISTINCT FROM 'group' THEN
        IF p_columns = '{"in":{"type":"integer","nullable":true},"from":{"type":"text","nullable":true},"to":{"type":"text","nullable":true}}'::jsonb THEN
        IF p_value IS NULL OR jsonb_typeof(p_value) <> 'object' THEN
          RAISE EXCEPTION '%: % value must be an object', p_path, CASE WHEN p_add THEN 'Add' ELSE 'Replace' END USING ERRCODE = '22023';
        END IF;
        SELECT string_agg(p_path || ': Unknown field: ' || k, '; ' ORDER BY k COLLATE "C") INTO v_bad FROM jsonb_object_keys(p_value) AS k WHERE k NOT IN ('id', 'valid_from', 'valid_to', 'group', 'in', 'from', 'to');
        SELECT string_agg(CASE WHEN p_field THEN p_path ELSE p_path || '/' || k END || ': ' || m, '; ' ORDER BY k COLLATE "C") INTO v_types FROM (VALUES
          ('group', CASE WHEN jsonb_typeof((p_value->'group')) = 'null' THEN CASE WHEN p_add THEN NULL ELSE 'group cannot be null' END
            WHEN NOT (jsonb_typeof((p_value->'group')) = 'string' OR (jsonb_typeof((p_value->'group')) = 'number' AND (p_value->'group')::text::numeric = trunc((p_value->'group')::text::numeric))) THEN 'group must be an id: an integer, or text' END),
          ('in', CASE WHEN jsonb_typeof((p_value->'in')) <> 'null' AND NOT (jsonb_typeof((p_value->'in')) = 'number' AND (p_value->'in')::text::numeric = trunc((p_value->'in')::text::numeric)) THEN 'in must be an integer' END),
          ('from', CASE WHEN jsonb_typeof((p_value->'from')) <> 'null' AND NOT (jsonb_typeof((p_value->'from')) = 'string') THEN 'from must be a string' END),
          ('to', CASE WHEN jsonb_typeof((p_value->'to')) <> 'null' AND NOT (jsonb_typeof((p_value->'to')) = 'string') THEN 'to must be a string' END)) AS x(k, m) WHERE m IS NOT NULL;
        IF v_bad IS NOT NULL OR v_types IS NOT NULL THEN RAISE EXCEPTION '%', concat_ws('; ', v_bad, v_types, p_missing) USING ERRCODE = '22023'; END IF;
        IF p_missing IS NOT NULL THEN RAISE EXCEPTION '%', p_missing USING ERRCODE = '23502'; END IF;
        RETURN;
        END IF;
      END IF;
    ELSE NULL;
  END CASE;
  -- another set of columns (a walk's, another version's): by the columns given
  PERFORM _delta_assert_fields_declared(p_collection, p_columns, p_parent_fk, p_value, p_path, p_add, p_field, p_missing);
END;
$$ LANGUAGE plpgsql IMMUTABLE;

"
`;
