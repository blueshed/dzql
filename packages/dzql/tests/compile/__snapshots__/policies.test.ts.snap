exports[`the compiled text is the same for the same definitions, and pinned 1`] = `
"CREATE OR REPLACE FUNCTION dzql_may__people(p_row "people", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- mine:
    COALESCE(((p_row)."id" = v_person), FALSE)
    OR -- team:
    COALESCE(EXISTS (SELECT 1 FROM "people" _p_people WHERE _p_people."team_id" = (CASE WHEN ((p_row)."team_id")::text ~ '^\\s*[+-]?[0-9]+\\s*$' THEN ((p_row)."team_id")::text::BIGINT END) AND _p_people."id" = v_person), FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__people("people", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('people', 'dzql_may__people');

CREATE OR REPLACE FUNCTION dzql_may__orgs(p_row "orgs", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- sealed:
    COALESCE(FALSE, FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__orgs("orgs", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('orgs', 'dzql_may__orgs');

CREATE OR REPLACE FUNCTION dzql_may__members(p_row "members", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- members:
    (COALESCE((v_person IS NOT NULL), FALSE) OR (NOT p_check AND COALESCE((v_person IS NOT NULL), FALSE)));
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__members("members", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('members', 'dzql_may__members');

CREATE OR REPLACE FUNCTION dzql_may__venues(p_row "venues", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- venue:
    COALESCE(EXISTS (SELECT 1 FROM "members" _p_members WHERE _p_members."org_id" = (p_row)."org_id" AND _p_members."active" = TRUE AND _p_members.valid_to IS NULL AND _p_members."person_id" = v_person), FALSE)
    OR -- venues-of:
    COALESCE(EXISTS (SELECT 1 FROM "members" _p_members WHERE _p_members."org_id" = (CASE WHEN ((p_row)."org_id")::text ~ '^\\s*[+-]?[0-9]+\\s*$' THEN ((p_row)."org_id")::text::BIGINT END) AND _p_members."active" = TRUE AND _p_members.valid_to IS NULL AND _p_members."person_id" = v_person), FALSE)
    OR -- venues:
    COALESCE(EXISTS (SELECT 1 FROM "members" _p_members WHERE _p_members."org_id" = 1 AND _p_members."active" = TRUE AND _p_members.valid_to IS NULL AND _p_members."person_id" = v_person), FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__venues("venues", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('venues', 'dzql_may__venues');

CREATE OR REPLACE FUNCTION dzql_may__posts(p_row "posts", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- post:
    COALESCE(((p_row)."author_id" = v_person), FALSE)
    OR -- board:
    COALESCE(TRUE, FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__posts("posts", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('posts', 'dzql_may__posts');

CREATE OR REPLACE FUNCTION dzql_may__tasks(p_row "tasks", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- mine:
    COALESCE(((p_row)."people_id" = v_person), FALSE)
    OR -- team:
    COALESCE(EXISTS (SELECT 1 FROM "people" _p_people WHERE _p_people."team_id" = (CASE WHEN ((SELECT r."team_id" FROM "people" r WHERE r.id = (p_row)."people_id"))::text ~ '^\\s*[+-]?[0-9]+\\s*$' THEN ((SELECT r."team_id" FROM "people" r WHERE r.id = (p_row)."people_id"))::text::BIGINT END) AND _p_people."id" = v_person), FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__tasks("tasks", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('tasks', 'dzql_may__tasks');
"
`;

exports[`the compiled text is the same for the same definitions, and pinned 2`] = `
"CREATE OR REPLACE FUNCTION dzql_may__boards(p_row "boards", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- board:
    (COALESCE(((p_row)."owner_id" = v_person), FALSE) OR (NOT p_check AND COALESCE(((SELECT r."owner_id" FROM "boards" r WHERE r.id = (p_row).id AND r.valid_to IS NULL) = v_person), FALSE)));
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__boards("boards", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('boards', 'dzql_may__boards');

CREATE OR REPLACE FUNCTION dzql_may__lists(p_row "lists", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- board:
    COALESCE(((SELECT r."owner_id" FROM "boards" r WHERE r.id = (p_row)."boards_id" AND r.valid_to IS NULL) = v_person), FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__lists("lists", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('lists', 'dzql_may__lists');

CREATE OR REPLACE FUNCTION dzql_may__cards(p_row "cards", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- board:
    COALESCE(((SELECT r."owner_id" FROM "boards" r WHERE r.id = (SELECT p."boards_id" FROM "lists" p WHERE p.id = (p_row)."lists_id") AND r.valid_to IS NULL) = v_person), FALSE)
    OR -- cards-by:
    COALESCE(((CASE WHEN ((p_row)."author_id")::text ~ '^\\s*[+-]?[0-9]+\\s*$' THEN ((p_row)."author_id")::text::BIGINT END) = v_person), FALSE);
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__cards("cards", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('cards', 'dzql_may__cards');

CREATE OR REPLACE FUNCTION dzql_may__labels(p_row "labels", p_check BOOLEAN)
RETURNS BOOLEAN AS $$
DECLARE
  v_user   TEXT := current_setting('app.user_id', true);
  v_person BIGINT := CASE WHEN v_user ~ '^\\s*[+-]?[0-9]+\\s*$' THEN v_user::BIGINT END;
  v_may    BOOLEAN;
  v_was_past TEXT := current_setting('dzql.definer', true);
BEGIN
  PERFORM set_config('dzql.definer', 'on', true);
  v_may := -- board:
    EXISTS (SELECT 1 FROM "boards" t WHERE TRUE AND t.valid_to IS NULL AND COALESCE((t."owner_id" = v_person), FALSE));
  PERFORM set_config('dzql.definer', COALESCE(v_was_past, ''), true);
  RETURN v_may;
END;
$$ LANGUAGE plpgsql STABLE SECURITY DEFINER;
DO $$
DECLARE
  v_path TEXT := COALESCE((SELECT string_agg(quote_ident(s), ', ') FROM unnest(current_schemas(false)) AS s), 'public') || ', pg_temp';
BEGIN
  EXECUTE format('ALTER FUNCTION dzql_may__labels("labels", boolean) SET search_path = %s', v_path);
END $$;
SELECT _delta_govern('labels', 'dzql_may__labels');

SELECT _delta_govern('notes', NULL);
"
`;
