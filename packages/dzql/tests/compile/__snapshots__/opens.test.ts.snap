-- fo-seats-at:: root seats
CREATE OR REPLACE FUNCTION dzql_open__fo_seats_at(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
  END IF;
  SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) INTO v_rows FROM "fo_seats" t WHERE (v_s1 IS NULL OR t."table_no" = v_s1::BIGINT);
  v_doc := jsonb_build_object('seats', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open__fo_seats_at_as(p_user_id TEXT, p_name TEXT)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open__fo_seats_at(p_name);
END
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_seats_at(p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'table_no must be an integer, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
  END IF;
  p_at := p_given;
  SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) INTO v_rows FROM "fo_seats" t WHERE (v_s1 IS NULL OR t."table_no" = v_s1::BIGINT);
  v_doc := jsonb_build_object('seats', v_rows);
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_seats_at_as(p_user_id TEXT, p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open_at__fo_seats_at(p_name, p_given);
END
$$ LANGUAGE plpgsql;

