-- fo-seating:: root weddings, includes seats
CREATE OR REPLACE FUNCTION dzql_open__fo_seating(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 12);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'name', t."name")), '{}'::jsonb) INTO v_rows FROM "fo_weddings" t WHERE TRUE;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) FROM "fo_seats" t));
  ELSE
    SELECT jsonb_build_object('id', t."id", 'name', t."name") INTO v_root FROM "fo_weddings" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) FROM "fo_seats" t WHERE t."weddings_id" = v_id));
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open__fo_seating_as(p_user_id TEXT, p_name TEXT)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open__fo_seating(p_name);
END
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_seating(p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 12);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  p_at := p_given;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'name', t."name")), '{}'::jsonb) INTO v_rows FROM "fo_weddings" t WHERE TRUE;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) FROM "fo_seats" t));
  ELSE
    SELECT jsonb_build_object('id', t."id", 'name', t."name") INTO v_root FROM "fo_weddings" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no", 'kept', t."kept", 'wishes', t."wishes")), '{}'::jsonb) FROM "fo_seats" t WHERE t."weddings_id" = v_id));
    END IF;
  END IF;
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_seating_as(p_user_id TEXT, p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
