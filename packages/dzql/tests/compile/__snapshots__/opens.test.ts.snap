  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-slim:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''name'', t."name")), ''{}''::jsonb) FROM "fo_weddings" t WHERE %s', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('households', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'email', t."email")), '{}'::jsonb) FROM "fo_households" t)) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no")), '{}'::jsonb) FROM "fo_seats" t));
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''name'', t."name") FROM "fo_weddings" t WHERE t.id = $1 AND %s', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('households', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'email', t."email")), '{}'::jsonb) FROM "fo_households" t WHERE t."weddings_id" = v_id)) || jsonb_build_object('seats', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'table_no', t."table_no")), '{}'::jsonb) FROM "fo_seats" t WHERE t."weddings_id" = v_id));
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

-- fo-notes-on:: root notes
CREATE OR REPLACE FUNCTION dzql_open__fo_notes_on(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-notes-on:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''text'', t."text")), ''{}''::jsonb) FROM "fo_notes" t WHERE %s AND (CASE WHEN $1 IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= $1 AND (t.valid_to IS NULL OR t.valid_to > $1) END)', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('notes', v_rows);
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''text'', t."text") FROM "fo_notes" t WHERE t.id = $1 AND %s AND (CASE WHEN $2 IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= $2 AND (t.valid_to IS NULL OR t.valid_to > $2) END)', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('notes', v_root);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

-- fo-courses-noted-on:: root courses, includes notes
CREATE OR REPLACE FUNCTION dzql_open__fo_courses_noted_on(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-courses-noted-on:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''name'', t."name")), ''{}''::jsonb) FROM "fo_courses" t WHERE %s', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('courses', v_rows) || jsonb_build_object('notes', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'text', t."text")), '{}'::jsonb) FROM "fo_notes" t WHERE (CASE WHEN p_at IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= p_at AND (t.valid_to IS NULL OR t.valid_to > p_at) END)));
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''name'', t."name") FROM "fo_courses" t WHERE t.id = $1 AND %s', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('courses', v_root) || jsonb_build_object('notes', '{}'::jsonb);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

