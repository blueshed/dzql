  p_at := p_given;
  SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'name', t."name")), '{}'::jsonb) INTO v_rows FROM "fo_courses" t WHERE (v_s1 IS NULL OR t."name" ILIKE v_s1 || '%');
  v_doc := jsonb_build_object('courses', v_rows);
  RETURN v_doc;
