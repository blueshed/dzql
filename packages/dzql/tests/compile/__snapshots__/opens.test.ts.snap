      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'courses_id', t."courses_id", 'name', t."name")), '{}'::jsonb) FROM "fo_drinks" t JOIN "fo_courses" p1 ON p1.id = t."courses_id" WHERE p1."weddings_id" = v_id));
