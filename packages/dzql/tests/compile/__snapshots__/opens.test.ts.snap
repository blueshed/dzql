CREATE OR REPLACE FUNCTION dzql_open_at__fo_title(p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 10);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  p_at := p_given;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'name', t."name")), '{}'::jsonb) INTO v_rows FROM "fo_weddings" t WHERE TRUE;
    v_doc := jsonb_build_object('weddings', v_rows);
  ELSE
    SELECT jsonb_build_object('id', t."id", 'name', t."name") INTO v_root FROM "fo_weddings" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root);
    END IF;
  END IF;
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

