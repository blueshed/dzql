-- fo-drinks:: root weddings, includes drinks
CREATE OR REPLACE FUNCTION dzql_open__fo_drinks(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-drinks:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''name'', t."name")), ''{}''::jsonb) FROM "fo_weddings" t WHERE %s', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'courses_id', t."courses_id", 'name', t."name")), '{}'::jsonb) FROM "fo_drinks" t));
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''name'', t."name") FROM "fo_weddings" t WHERE t.id = $1 AND %s', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'courses_id', t."courses_id", 'name', t."name")), '{}'::jsonb) FROM "fo_drinks" t JOIN "fo_courses" p1 ON p1.id = t."courses_id" WHERE p1."weddings_id" = v_id));
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

-- fo-course-guests:: root courses, includes households
CREATE OR REPLACE FUNCTION dzql_open__fo_course_guests(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-course-guests:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''name'', t."name")), ''{}''::jsonb) FROM "fo_courses" t WHERE %s', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('courses', v_rows) || jsonb_build_object('households', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'email', t."email", 't', t."t")), '{}'::jsonb) FROM "fo_households" t));
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''weddings_id'', t."weddings_id", ''name'', t."name") FROM "fo_courses" t WHERE t.id = $1 AND %s', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('courses', v_root) || jsonb_build_object('households', '{}'::jsonb);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

-- fo-plan:: root weddings, includes courses, drinks, implied
CREATE OR REPLACE FUNCTION dzql_open__fo_plan(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  v_scope  JSONB;
  v_where  TEXT;
  p_at     TIMESTAMPTZ;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
BEGIN
  v_scope := _delta_resolve_scope((SELECT d FROM _delta_docs d WHERE d.prefix = 'fo-plan:'), p_name);
  v_where := v_scope->>'where';
  p_at := (v_scope->>'at')::TIMESTAMPTZ;
  IF v_scope->>'mode' = 'list' THEN
    EXECUTE format('SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object(''id'', t."id", ''name'', t."name")), ''{}''::jsonb) FROM "fo_weddings" t WHERE %s', v_where)
      INTO v_rows USING p_at;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('courses', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'name', t."name")), '{}'::jsonb) FROM "fo_courses" t)) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'courses_id', t."courses_id", 'name', t."name")), '{}'::jsonb) FROM "fo_drinks" t));
  ELSE
    v_id := (v_scope->'values'->>'id')::BIGINT;
    EXECUTE format('SELECT jsonb_build_object(''id'', t."id", ''name'', t."name") FROM "fo_weddings" t WHERE t.id = $1 AND %s', v_where)
      INTO v_root USING v_id, p_at;
    IF v_root IS NULL THEN
      v_doc := jsonb_build_object('weddings', jsonb_build_object('id', v_id) || '{"name":""}'::jsonb) || jsonb_build_object('courses', '{}'::jsonb) || jsonb_build_object('drinks', '{}'::jsonb);
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('courses', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'name', t."name")), '{}'::jsonb) FROM "fo_courses" t WHERE t."weddings_id" = v_id)) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'courses_id', t."courses_id", 'name', t."name")), '{}'::jsonb) FROM "fo_drinks" t JOIN "fo_courses" p1 ON p1.id = t."courses_id" WHERE p1."weddings_id" = v_id));
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

