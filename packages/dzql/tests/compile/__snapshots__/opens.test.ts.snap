CREATE OR REPLACE FUNCTION dzql_open(p_name TEXT)
RETURNS JSONB AS $$
BEGIN
  IF starts_with(p_name, 'fo-courses-noted-on:') THEN RETURN dzql_open__fo_courses_noted_on(p_name); END IF;
  IF starts_with(p_name, 'fo-all-households:') THEN RETURN dzql_open__fo_all_households(p_name); END IF;
  IF starts_with(p_name, 'fo-course-guests:') THEN RETURN dzql_open__fo_course_guests(p_name); END IF;
  IF starts_with(p_name, 'fo-courses-noted:') THEN RETURN dzql_open__fo_courses_noted(p_name); END IF;
  IF starts_with(p_name, 'fo-tags-labelled:') THEN RETURN dzql_open__fo_tags_labelled(p_name); END IF;
  IF starts_with(p_name, 'fo-courses-like:') THEN RETURN dzql_open__fo_courses_like(p_name); END IF;
  IF starts_with(p_name, 'fo-seats-wished:') THEN RETURN dzql_open__fo_seats_wished(p_name); END IF;
  IF starts_with(p_name, 'fo-all-courses:') THEN RETURN dzql_open__fo_all_courses(p_name); END IF;
  IF starts_with(p_name, 'fo-pub-courses:') THEN RETURN dzql_open__fo_pub_courses(p_name); END IF;
  IF starts_with(p_name, 'fo-slots-under:') THEN RETURN dzql_open__fo_slots_under(p_name); END IF;
  IF starts_with(p_name, 'fo-seats-kept:') THEN RETURN dzql_open__fo_seats_kept(p_name); END IF;
  IF starts_with(p_name, 'fo-seats-upto:') THEN RETURN dzql_open__fo_seats_upto(p_name); END IF;
  IF starts_with(p_name, 'fo-slots-upto:') THEN RETURN dzql_open__fo_slots_upto(p_name); END IF;
  IF starts_with(p_name, 'fo-all-notes:') THEN RETURN dzql_open__fo_all_notes(p_name); END IF;
  IF starts_with(p_name, 'fo-asks-from:') THEN RETURN dzql_open__fo_asks_from(p_name); END IF;
  IF starts_with(p_name, 'fo-household:') THEN RETURN dzql_open__fo_household(p_name); END IF;
  IF starts_with(p_name, 'fo-menu-like:') THEN RETURN dzql_open__fo_menu_like(p_name); END IF;
  IF starts_with(p_name, 'fo-board-on:') THEN RETURN dzql_open__fo_board_on(p_name); END IF;
  IF starts_with(p_name, 'fo-notes-on:') THEN RETURN dzql_open__fo_notes_on(p_name); END IF;
  IF starts_with(p_name, 'fo-seats-at:') THEN RETURN dzql_open__fo_seats_at(p_name); END IF;
  IF starts_with(p_name, 'fo-slots-by:') THEN RETURN dzql_open__fo_slots_by(p_name); END IF;
  IF starts_with(p_name, 'fo-slots-of:') THEN RETURN dzql_open__fo_slots_of(p_name); END IF;
  IF starts_with(p_name, 'fo-slots-on:') THEN RETURN dzql_open__fo_slots_on(p_name); END IF;
  IF starts_with(p_name, 'fo-weddings:') THEN RETURN dzql_open__fo_weddings(p_name); END IF;
  IF starts_with(p_name, 'fo-catalog:') THEN RETURN dzql_open__fo_catalog(p_name); END IF;
  IF starts_with(p_name, 'fo-seat-of:') THEN RETURN dzql_open__fo_seat_of(p_name); END IF;
  IF starts_with(p_name, 'fo-seating:') THEN RETURN dzql_open__fo_seating(p_name); END IF;
  IF starts_with(p_name, 'fo-course:') THEN RETURN dzql_open__fo_course(p_name); END IF;
  IF starts_with(p_name, 'fo-drinks:') THEN RETURN dzql_open__fo_drinks(p_name); END IF;
  IF starts_with(p_name, 'fo-tagged:') THEN RETURN dzql_open__fo_tagged(p_name); END IF;
  IF starts_with(p_name, 'fo-board:') THEN RETURN dzql_open__fo_board(p_name); END IF;
  IF starts_with(p_name, 'fo-guest:') THEN RETURN dzql_open__fo_guest(p_name); END IF;
  IF starts_with(p_name, 'fo-notes:') THEN RETURN dzql_open__fo_notes(p_name); END IF;
  IF starts_with(p_name, 'fo-party:') THEN RETURN dzql_open__fo_party(p_name); END IF;
  IF starts_with(p_name, 'fo-title:') THEN RETURN dzql_open__fo_title(p_name); END IF;
  IF starts_with(p_name, 'fo-asks:') THEN RETURN dzql_open__fo_asks(p_name); END IF;
  IF starts_with(p_name, 'fo-menu:') THEN RETURN dzql_open__fo_menu(p_name); END IF;
  IF starts_with(p_name, 'fo-note:') THEN RETURN dzql_open__fo_note(p_name); END IF;
  IF starts_with(p_name, 'fo-plan:') THEN RETURN dzql_open__fo_plan(p_name); END IF;
  IF starts_with(p_name, 'fo-slim:') THEN RETURN dzql_open__fo_slim(p_name); END IF;
  RAISE EXCEPTION 'no doc def for: %', p_name USING ERRCODE = 'P0001';
END;
$$ LANGUAGE plpgsql;

"
`;
