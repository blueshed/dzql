  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'name', t."name")), '{}'::jsonb) INTO v_rows FROM "fo_courses" t WHERE TRUE;
    v_doc := jsonb_build_object('courses', v_rows);
  ELSE
    SELECT jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'name', t."name") INTO v_root FROM "fo_courses" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
