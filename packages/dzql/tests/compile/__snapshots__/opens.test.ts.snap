  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  p_at := p_given;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_weddings" t WHERE TRUE;
    v_doc := jsonb_build_object('weddings', v_rows) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) FROM "fo_drinks" t));
  ELSE
    SELECT to_jsonb(t.*) INTO v_root FROM "fo_weddings" t WHERE t.id = v_id;
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('weddings', v_root) || jsonb_build_object('drinks', (SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) FROM "fo_drinks" t JOIN "fo_courses" p1 ON p1.id = t."courses_id" WHERE p1."weddings_id" = v_id));
    END IF;
  END IF;
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

