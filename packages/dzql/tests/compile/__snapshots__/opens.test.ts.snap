    v_date := regexp_match(v_s1, '^\\s*([0-9]{4})-([0-9]{2})-([0-9]{2})\\s*$');
    IF v_date IS NULL OR v_date[1]::int < 1 OR v_date[2]::int NOT BETWEEN 1 AND 12 THEN
      RAISE EXCEPTION 'starts must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    ELSIF v_date[3]::int NOT BETWEEN 1 AND extract(day FROM make_date(v_date[1]::int, v_date[2]::int, 1) + interval '1 month - 1 day')::int THEN
      RAISE EXCEPTION 'starts must be a date, YYYY-MM-DD, not "%"', v_s1 USING ERRCODE = '22P02';
    END IF;
    v_s1 := format('%s-%s-%s 00:00:00+00', v_date[1], v_date[2], v_date[3]);
  END IF;
  p_at := p_given;
  SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'price', t."price", 'starts', t."starts")), '{}'::jsonb) INTO v_rows FROM "fo_slots" t WHERE (v_s1 IS NULL OR t."starts" = v_s1::TIMESTAMPTZ);
  v_doc := jsonb_build_object('slots', v_rows);
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_slots_on_as(p_user_id TEXT, p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open_at__fo_slots_on(p_name, p_given);
END
$$ LANGUAGE plpgsql;

-- fo-note:: root notes
CREATE OR REPLACE FUNCTION dzql_open__fo_note(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 9);
  v_single := v_rest <> '';
  IF v_single THEN v_id := v_rest::BIGINT; END IF;
  IF NOT v_single THEN
    SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'text', t."text")), '{}'::jsonb) INTO v_rows FROM "fo_notes" t WHERE TRUE AND (CASE WHEN p_at IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= p_at AND (t.valid_to IS NULL OR t.valid_to > p_at) END);
    v_doc := jsonb_build_object('notes', v_rows);
  ELSE
    SELECT jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'text', t."text") INTO v_root FROM "fo_notes" t WHERE t.id = v_id AND (CASE WHEN p_at IS NULL THEN t.valid_to IS NULL ELSE t.valid_from <= p_at AND (t.valid_to IS NULL OR t.valid_to > p_at) END);
    IF v_root IS NULL THEN
      RETURN NULL;
    ELSE
      v_doc := jsonb_build_object('notes', v_root);
    END IF;
  END IF;
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

