-- fo-asks-from:: root asks
CREATE OR REPLACE FUNCTION dzql_open__fo_asks_from(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
