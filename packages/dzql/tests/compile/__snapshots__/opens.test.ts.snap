CREATE OR REPLACE FUNCTION dzql_open_at__fo_pub_courses_as(p_user_id TEXT, p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
