-- fo-slim:: root weddings, includes households, seats, holds households(email) seats(table_no)
CREATE OR REPLACE FUNCTION dzql_open__fo_slim(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_rest TEXT;
BEGIN
  v_rest := substring(p_name FROM 9);
  v_single := v_rest <> '';
