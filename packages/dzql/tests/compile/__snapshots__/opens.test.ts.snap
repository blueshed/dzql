-- fo-slots-of:: root slots
CREATE OR REPLACE FUNCTION dzql_open__fo_slots_of(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
  v_n1 BOOLEAN;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 13), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 ~ '^\\s*[+-]?[0-9]+\\s*$' THEN
      IF v_s1 !~ '^\\s*[+-]?0*[0-9]{1,16}\\s*$' THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      ELSIF abs(v_s1::numeric) > 9007199254740991 THEN RAISE EXCEPTION 'weddings_id % is past 2^53 - 1, which no number holds exactly', v_s1 USING ERRCODE = '22P02';
      END IF;
      v_n1 := TRUE;
    ELSIF v_s1 ~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN
      RAISE EXCEPTION 'weddings_id must be an id -- a whole number, or text -- not "%"', v_s1 USING ERRCODE = '22P02';
    ELSE
      v_n1 := FALSE;
    END IF;
  END IF;
  SELECT COALESCE(jsonb_object_agg(t.id, jsonb_build_object('id', t."id", 'weddings_id', t."weddings_id", 'price', t."price", 'starts', t."starts")), '{}'::jsonb) INTO v_rows FROM "fo_slots" t WHERE (v_s1 IS NULL OR (CASE WHEN v_n1 THEN t."weddings_id" = v_s1::BIGINT ELSE FALSE END));
  v_doc := jsonb_build_object('slots', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open__fo_slots_of_as(p_user_id TEXT, p_name TEXT)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open__fo_slots_of(p_name);
END
$$ LANGUAGE plpgsql;

