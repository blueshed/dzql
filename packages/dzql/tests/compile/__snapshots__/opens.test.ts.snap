-- fo-slots-upto:: root slots
CREATE OR REPLACE FUNCTION dzql_open__fo_slots_upto(p_name TEXT)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
    BEGIN
      PERFORM v_s1::float8;
    EXCEPTION WHEN numeric_value_out_of_range THEN
      RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_slots" t WHERE (v_s1 IS NULL OR t."price" <= v_s1::DOUBLE PRECISION);
  v_doc := jsonb_build_object('slots', v_rows);
  INSERT INTO _delta_versions (doc_name, version) VALUES (p_name, 0) ON CONFLICT (doc_name) DO NOTHING;
  SELECT version INTO v_version FROM _delta_versions WHERE doc_name = p_name;
  RETURN v_doc || jsonb_build_object('_version', v_version);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open__fo_slots_upto_as(p_user_id TEXT, p_name TEXT)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open__fo_slots_upto(p_name);
END
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_slots_upto(p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
DECLARE
  p_at     TIMESTAMPTZ;
  v_single BOOLEAN;
  v_id     BIGINT;
  v_rows   JSONB;
  v_root   JSONB;
  v_doc    JSONB;
  v_version BIGINT;
  v_parts TEXT[];
  v_date TEXT[];
  v_s1 TEXT;
BEGIN
  v_parts := string_to_array(substring(p_name FROM 15), ':');
  v_single := FALSE;
  v_s1 := NULLIF(v_parts[1], '');
  IF v_s1 IS NOT NULL THEN
    IF v_s1 !~* '^\\s*[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)(e[+-]?[0-9]+)?\\s*$' THEN RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02'; END IF;
    BEGIN
      PERFORM v_s1::float8;
    EXCEPTION WHEN numeric_value_out_of_range THEN
      RAISE EXCEPTION 'price must be a number, not "%"', v_s1 USING ERRCODE = '22P02';
    END;
  END IF;
  p_at := p_given;
  SELECT COALESCE(jsonb_object_agg(t.id, to_jsonb(t.*)), '{}'::jsonb) INTO v_rows FROM "fo_slots" t WHERE (v_s1 IS NULL OR t."price" <= v_s1::DOUBLE PRECISION);
  v_doc := jsonb_build_object('slots', v_rows);
  RETURN v_doc;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION dzql_open_at__fo_slots_upto_as(p_user_id TEXT, p_name TEXT, p_given TIMESTAMPTZ)
RETURNS JSONB AS $$
BEGIN
  PERFORM set_config('app.user_id', p_user_id, true);
  RETURN dzql_open_at__fo_slots_upto(p_name, p_given);
