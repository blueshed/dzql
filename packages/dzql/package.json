{
  "name": "dzql",
  "version": "0.14.0",
  "description": "Stories to documents to pages, and the compiled Postgres step: eta's modelling and rendering, and delta's definitions compiled to SQL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueshed/dzql.git",
    "directory": "packages/dzql"
  },
  "type": "module",
  "bin": {
    "dzql": "./src/cli/index.ts"
  },
  "exports": {
    "./modelling": "./src/modelling/index.ts",
    "./modelling/stories": "./src/modelling/stories.ts",
    "./modelling/harness": "./src/modelling/harness.ts",
    "./modelling/guards": "./src/modelling/guards.ts",
    "./modelling/reading": "./src/modelling/reading.ts",
    "./modelling/definitions": "./src/modelling/definitions.ts",
    "./modelling/costs": "./src/modelling/costs.ts",
    "./model": "./src/cli/model.ts",
    "./rendering": "./src/rendering/index.ts",
    "./rendering/bento.css": "./src/rendering/bento.css",
    "./rendering/bento-plain.css": "./src/rendering/bento-plain.css",
    "./rendering/server": "./src/rendering/server.ts",
    "./rendering/documents": "./src/rendering/documents.ts",
    "./rendering/html": "./src/rendering/html.ts",
    "./rendering/bento": "./src/rendering/bento.ts",
    "./rendering/refusal": "./src/rendering/refusal.ts",
    "./rendering/json-patch": "./src/rendering/json-patch.ts",
    "./rendering/example": "./src/rendering/example.ts",
    "./rendering/resources/resource": "./src/rendering/resources/resource.ts",
    "./rendering/resources/index": "./src/rendering/resources/index.ts",
    "./rendering/resources/audience": "./src/rendering/resources/audience.ts",
    "./rendering/applets": "./src/rendering/applets.ts",
    "./rendering/parts": "./src/rendering/parts.ts",
    "./rendering/derive": "./src/rendering/derive.ts",
    "./rendering/grid": "./src/rendering/grid.ts",
    "./rendering/icons": "./src/rendering/icons.ts",
    "./rendering/island": "./src/rendering/island.ts",
    "./rendering/sessions": "./src/rendering/sessions.ts",
    "./rendering/scope": "./src/rendering/scope.ts",
    "./rendering/names": "./src/rendering/names.ts",
    "./rendering/links": "./src/rendering/links.ts",
    "./rendering/db": "./src/rendering/db.ts",
    "./rendering/cli": "./src/rendering/cli.ts",
    "./rendering/cli/commands": "./src/rendering/cli/commands.ts",
    "./rendering/client/app": "./src/rendering/client/app.ts",
    "./rendering/client/tools": "./src/rendering/client/tools.ts",
    "./rendering/test-socket": "./src/rendering/test-socket.ts",
    "./rendering/webview": "./src/rendering/webview.ts",
    "./postgres": "./src/postgres/index.ts",
    "./pglite": "./src/postgres/pglite.ts",
    "./auth-jwt": "./src/postgres/auth-jwt.ts",
    "./auth-link": "./src/postgres/auth-link.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "examples/modeling",
    "!examples/modeling/**/*.test.*",
    "examples/cafe",
    "!examples/cafe/**/*.test.*",
    ".claude/skills",
    "README.md"
  ],
  "scripts": {
    "test": "bun run test:fast",
    "test:setup": "docker compose down -v && docker compose up -d --wait",
    "test:teardown": "docker compose down -v",
    "test:eta": "bun scripts/eta.ts",
    "bench": "bun run bench/run.ts",
    "dev": "bun --watch src/rendering/start.ts",
    "dev:wedding": "ETA_EXAMPLE=wedding PORT=3001 bun --watch src/rendering/start.ts",
    "dev:cafe": "ETA_EXAMPLE=cafe PORT=3006 bun --hot examples/cafe/routes.ts --model",
    "dev:ticker": "ETA_EXAMPLE=ticker PORT=3002 bun --watch src/rendering/start.ts",
    "dev:leave": "ETA_EXAMPLE=leave PORT=3004 bun --watch src/rendering/start.ts",
    "dev:modeling": "ETA_EXAMPLE=modeling PORT=3005 bun --watch src/rendering/start.ts",
    "cli": "bun src/rendering/cli.ts",
    "stories": "bun --env-file=.env.test src/modelling/stories-run.ts",
    "stories:all": "bun scripts/stories-all.ts",
    "costs": "bun --env-file=.env.test src/modelling/costs.ts",
    "model:check": "LOG_LEVEL=warn bun --env-file=.env.test examples/modeling/loader/check.ts",
    "model:load": "LOG_LEVEL=warn bun --env-file=.env.test examples/modeling/loader/load.ts",
    "test:fast": "bun check && bun run test:fast:pg && bun scripts/fast-eta.ts",
    "test:fast:pg": "bun check && bun --config=tests/fast.bunfig.toml test tests/compile/",
    "test:fast:eta": "bun check && bun scripts/fast-eta.ts",
    "test:slow": "bun run test:pg && bun run test:eta && bun run stories:all && bun run costs --check",
    "test:eta:ci": "bun scripts/eta.ts --ci",
    "start": "NODE_ENV=production bun src/rendering/start.ts",
    "stop": "delta stop",
    "test:pg": "bun run test:setup && bun --config=tests/bunfig.toml test tests/; status=$?; bun run test:teardown; exit $status"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "database",
    "bun",
    "typescript",
    "compiler",
    "codegen",
    "delta",
    "stories",
    "server-rendered",
    "eta"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "devDependencies": {
    "@blueshed/railroad": "^0.17.0",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.20.0",
    "@blueshed/delta": "^1.2.0",
    "lucide": "^1.46.0",
    "@electric-sql/pglite": "^0.5.4",
    "jose": "^6.2.4",
    "pg": "^8.22.0"
  },
  "peerDependencies": {
    "@blueshed/delta": "^1.2.0",
    "@blueshed/railroad": "^0.16.2 || ^0.17.0",
    "@electric-sql/pglite": "^0.5.4",
    "jose": "^6.2.4",
    "pg": "^8.22.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "peerDependenciesMeta": {
    "@blueshed/railroad": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
