{
  "name": "dzql",
  "version": "0.5.17",
  "description": "PostgreSQL-powered framework with zero boilerplate CRUD operations and real-time WebSocket synchronization",
  "type": "module",
  "main": "src/server/index.js",
  "exports": {
    ".": "./src/server/index.js",
    "./client": "./src/client/ws.js",
    "./client/stores": "./src/client/stores/index.js",
    "./client/templates": "./src/client/templates/App.vue",
    "./server": "./src/server/index.js",
    "./db": "./src/server/db.js",
    "./compiler": "./src/compiler/index.js",
    "./namespace": "./src/server/namespace.js"
  },
  "files": [
    "bin/**/*.js",
    "src/**/*.js",
    "src/database/**/*.sql",
    "docs/**/*.md",
    "docs/examples/*.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test ../../tests/core/*.test.js",
    "prepublishOnly": "echo '✅ Publishing DZQL...'  "
  },
  "dependencies": {
    "jose": "^6.1.0",
    "postgres": "^3.4.7"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "websocket",
    "real-time",
    "realtime",
    "crud",
    "api",
    "framework",
    "zero-boilerplate",
    "database",
    "bun",
    "graph-rules",
    "permissions",
    "row-level-security",
    "rls",
    "notify",
    "listen",
    "subscriptions"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql",
    "directory": "packages/dzql"
  },
  "bugs": {
    "url": "https://github.com/blueshed/dzql/issues"
  },
  "homepage": "https://github.com/blueshed/dzql#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
