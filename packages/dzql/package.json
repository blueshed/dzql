{
  "name": "dzql",
  "version": "0.11.0",
  "description": "delta's compiled Postgres step: an app's delta definitions compiled to SQL",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/dzql"
  },
  "type": "module",
  "bin": {
    "dzql": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/runtime/index.ts",
    "./client": "./src/client/index.ts",
    "./compiler": "./src/cli/index.ts",
    "./namespace": "./src/runtime/namespace.ts",
    "./postgres": "./src/postgres/index.ts",
    "./pglite": "./src/postgres/pglite.ts",
    "./auth-jwt": "./src/postgres/auth-jwt.ts",
    "./compile": "./src/compile/opens.ts"
  },
  "files": [
    "src",
    "docs/README.md",
    "docs/project-setup.md",
    "docs/for_ai.md",
    "README.md"
  ],
  "scripts": {
    "test": "bun run test:setup && bun test; status=$?; bun run test:teardown; exit $status",
    "test:setup": "docker compose down -v && docker compose up -d --wait",
    "test:teardown": "docker compose down -v",
    "bench": "bun run bench/run.ts"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "websocket",
    "real-time",
    "realtime",
    "database",
    "bun",
    "vue",
    "pinia",
    "typescript",
    "compiler",
    "codegen"
  ],
  "author": "Peter Bunyan",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "dotenv": "^16.4.5",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@blueshed/railroad": "^0.16.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "pinia": "^3.0.4",
    "typescript": "^5.0.0",
    "vue": "^3.5.26",
    "@blueshed/delta": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "@blueshed/delta": "^1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
