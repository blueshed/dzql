{
  "name": "create-blueshed",
  "version": "0.4.0",
  "type": "module",
  "description": "Start a Bun website from paintbrush: routes and resources, railroad for the page, delta for the documents, Railway for the deploy",
  "bin": {
    "create-blueshed": "./cli.ts"
  },
  "files": [
    "cli.ts",
    "template",
    "README.md"
  ],
  "scripts": {
    "prepack": "bun pack.ts ../paintbrush",
    "postpack": "rm -rf template",
    "test:fast": "bun test tests/",
    "test": "bun run test:fast",
    "test:slow": "bun run --cwd ../paintbrush test:slow"
  },
  "keywords": [
    "create",
    "starter",
    "bun",
    "railroad",
    "delta",
    "railway",
    "paintbrush"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueshed/dzql.git",
    "directory": "packages/create-blueshed"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.3"
  }
}
