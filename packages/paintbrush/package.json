{
  "name": "paintbrush",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --hot src/routes.ts",
    "stop": "delta stop",
    "typecheck": "bun check",
    "test": "bun run test:fast",
    "model": "dzql model",
    "test:evolve": "bun test ./tests/evolve.ts",
    "start": "NODE_ENV=production bun src/routes.ts",
    "test:fast": "bun check && bun test",
    "test:slow": "bun run test:evolve"
  },
  "dependencies": {
    "@blueshed/delta": "^1.3.0",
    "@blueshed/railroad": "^0.17.0",
    "lucide": "^1.51.0",
    "dzql": "^0.14.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "railway": "^3.12.0"
  },
  "claudeSkills": [
    "dzql"
  ]
}
