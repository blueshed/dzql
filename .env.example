PORT=3000
DB_PATH=db.sqlite

# Where `bun run start` writes its pid and `bun run stop` looks for it.
# PID_FILE=server.pid

# Defaults to the migrations/ dir next to the source. Only needed if you're
# running against a checkout laid out differently.
# MIGRATIONS_DIR=./migrations

# "production" enables secure (HTTPS-only) cookies and turns off Bun's
# dev-mode HTML bundling. Leave unset for local development.
# NODE_ENV=production

# Only read by the CLI (bun run cli) -- which server it talks to.
# ETA_URL=ws://localhost:3000
