# ==============================================
# DZQL Environment Configuration
# ==============================================
# Copy this file to .env and update values

# ----------------------------------------------
# Database Configuration (Required)
# ----------------------------------------------
DATABASE_URL=postgresql://dzql:dzql@localhost:5432/dzql

# ----------------------------------------------
# Security (REQUIRED in production)
# ----------------------------------------------
# JWT secret for signing authentication tokens
# MUST be set in production - minimum 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Token expiration time (default: 7d)
# Examples: "1h", "7d", "30d", "365d"
JWT_EXPIRES_IN=7d

# ----------------------------------------------
# Server Configuration
# ----------------------------------------------
# Server port (default: 3000)
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Static file serving path (optional)
# If set, serves static files from this directory
# STATIC_PATH=./public

# ----------------------------------------------
# Database Connection Pool
# ----------------------------------------------
# Maximum number of database connections (default: 10)
DB_MAX_CONNECTIONS=10

# Connection idle timeout in seconds (default: 20)
DB_IDLE_TIMEOUT=20

# Connection timeout in seconds (default: 10)
DB_CONNECT_TIMEOUT=10

# ----------------------------------------------
# Logging Configuration
# ----------------------------------------------
# Overall log level: ERROR, WARN, INFO, DEBUG, TRACE
# Default: INFO in development, WARN in production
LOG_LEVEL=INFO

# Per-category log levels (comma-separated)
# Categories: ws, db, auth, server, notify
# Example: ws:debug,db:trace,auth:info
# LOG_CATEGORIES=ws:debug,db:info,auth:info,server:info,notify:debug

# Set to 1 to disable colors in logs
# NO_COLOR=1

# ----------------------------------------------
# Rate Limiting (Future)
# ----------------------------------------------
# Maximum requests per window (default: 100)
# RATE_LIMIT_MAX=100

# Rate limit window in seconds (default: 60)
# RATE_LIMIT_WINDOW=60

# ----------------------------------------------
# WebSocket Configuration
# ----------------------------------------------
# IMPORTANT: Heroku and some cloud platforms require keepalive
# to prevent connection timeouts. The defaults below work well
# for most platforms including Heroku (55s timeout).

# Idle timeout / ping interval in milliseconds (default: 30000 = 30s)
# Connections idle longer than this will be pinged
# For Heroku: Keep below 55 seconds to prevent H15 errors
WS_PING_INTERVAL=30000

# Ping response timeout in milliseconds (default: 5000 = 5s)
# Connection will close if no pong received within this time
WS_PING_TIMEOUT=5000

# Maximum message size in bytes (default: 1048576 = 1MB)
# Increase if you need to send larger payloads
WS_MAX_MESSAGE_SIZE=1048576

# ----------------------------------------------
# Development/Testing
# ----------------------------------------------
# Enable SQL query logging (development only)
# SQL_DEBUG=false

# Enable detailed error messages (development only)
# DETAILED_ERRORS=true
