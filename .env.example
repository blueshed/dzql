PORT=3000
DB_PATH=db.sqlite

# Where `bun run start` writes its pid and `bun run stop` looks for it.
# PID_FILE=server.pid

# Where `bun run start` redirects the detached process's output.
# LOG_FILE=server.log

# Defaults to the migrations/ dir next to the source. Only needed if you're
# running against a checkout laid out differently.
# MIGRATIONS_DIR=./migrations

# "production" enables secure (HTTPS-only) cookies and turns off Bun's
# dev-mode HTML bundling. Leave unset for local development.
# NODE_ENV=production

# Only read by the CLI (bun run cli) -- which server it talks to.
# ETA_URL=ws://localhost:3000

# Which example under examples/ to run -- resolves examples/<name>/index.ts
# for its `example` export (src/start.ts) and examples/<name>/cli.ts for its
# alias table, if that file exists (src/cli.ts). Defaults to "chat".
# ETA_EXAMPLE=chat

# Only read by the ticker example: milliseconds between the feed's ticks while
# anyone is connected (0 for no feed), and the clock's time zone.
# TICK_MS=500
# CLOCK_TZ=Europe/Zurich

# Only read by the wedding example: "1" prints the names on the photo before
# the day has come, for a demo of the reveal.
# REVEAL=1
